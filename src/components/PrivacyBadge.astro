---
interface Props {
  variant?: 'header' | 'tool-proof' | 'compact' | 'architecture';
  class?: string;
}

const { variant = 'compact', class: className = '' } = Astro.props;
---

{variant === 'header' && (
  <div class={`inline-flex items-center gap-2 px-2.5 py-1 rounded-full text-xs font-medium bg-surface-100/90 text-surface-700 border border-surface-200/90 select-none ${className}`}>
    <span class="flex h-2 w-2 relative">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-60"></span>
      <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
    </span>
    <span class="text-surface-600 font-mono text-[11px]">Local Sandbox &bull; 0 Bytes Uploaded</span>
  </div>
)}

{variant === 'compact' && (
  <div class={`inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-50 text-emerald-800 border border-emerald-200/80 select-none ${className}`}>
    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
    <span class="font-medium text-[11px]">On-Device Sandbox &bull; Zero Uploads</span>
  </div>
)}

{variant === 'tool-proof' && (
  <div class={`flex items-center gap-2.5 px-3.5 py-2 rounded-lg bg-surface-50 border border-surface-200/80 text-xs text-surface-600 ${className}`}>
    <div class="w-5 h-5 rounded-md bg-emerald-100 text-emerald-700 flex items-center justify-center flex-shrink-0">
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
      </svg>
    </div>
    <span class="leading-tight">
      <strong class="text-surface-900 font-semibold">Client-Side Memory:</strong> Files are processed 100% inside your browser sandbox. 0 bytes transmitted to any server.
    </span>
  </div>
)}

{variant === 'architecture' && (
  <div class={`p-4 rounded-xl bg-white border border-surface-200/90 shadow-2xs ${className}`}>
    <div class="flex items-start gap-3">
      <div class="w-8 h-8 rounded-lg bg-surface-100 text-surface-800 flex items-center justify-center flex-shrink-0 mt-0.5">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
        </svg>
      </div>
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-surface-900">
          Hardware-Isolated Security Guarantee
        </h4>
        <p class="text-xs text-surface-600 mt-1 leading-relaxed">
          Conversions run in memory via compiled WebAssembly and HTML5 Canvas. Inspect network activity in DevTools (<kbd class="px-1 py-0.5 bg-surface-100 border border-surface-200 rounded font-mono text-[10px]">F12</kbd> &rarr; Network) to verify zero outbound file payloads.
        </p>
      </div>
    </div>
  </div>
)}
