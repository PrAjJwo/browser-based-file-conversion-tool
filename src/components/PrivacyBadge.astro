---
interface Props {
  variant?: 'subtle' | 'prominent' | 'compact';
  class?: string;
}

const { variant = 'subtle', class: className = '' } = Astro.props;
---

{variant === 'compact' && (
  <div class={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-50 text-emerald-800 border border-emerald-200/80 ${className}`}>
    <svg class="w-3.5 h-3.5 text-emerald-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
    </svg>
    <span>100% In-Browser • Zero Uploads</span>
  </div>
)}

{variant === 'subtle' && (
  <div class={`inline-flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs md:text-sm font-medium bg-emerald-50/90 text-emerald-900 border border-emerald-200 ${className}`}>
    <span class="flex h-2 w-2 relative">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
      <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
    </span>
    <span class="font-semibold text-emerald-700">100% Client-Side:</span>
    <span class="text-emerald-800">Your files never leave your device. Everything is processed in your browser.</span>
  </div>
)}

{variant === 'prominent' && (
  <div class={`p-4 rounded-xl bg-gradient-to-r from-emerald-50 via-teal-50 to-emerald-50 border border-emerald-200/80 shadow-sm ${className}`}>
    <div class="flex items-start gap-3">
      <div class="p-2 rounded-lg bg-emerald-100 text-emerald-700 flex-shrink-0 mt-0.5">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
      </div>
      <div>
        <h4 class="text-sm font-semibold text-emerald-950 flex flex-wrap items-center gap-2">
          Strict Privacy Guarantee
          <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded bg-emerald-200/70 text-emerald-800">Zero Server Uploads</span>
        </h4>
        <p class="text-xs md:text-sm text-emerald-900 font-semibold mt-1 leading-relaxed">
          Your files never leave your device. Everything is processed in your browser.
        </p>
        <p class="text-xs text-emerald-800 mt-0.5 leading-relaxed">
          Unlike traditional conversion websites with remote server queues and cloud storage, our tools run 100% locally on your device hardware using modern WebAssembly and Canvas APIs.
        </p>
      </div>
    </div>
  </div>
)}
