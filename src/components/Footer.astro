---
import { getAllCategories, getToolsByCategory } from '../data/tools';
import BrandLogo from './BrandLogo.astro';

const categories = getAllCategories();
---

<footer class="border-t border-surface-200 bg-white text-surface-600 mt-16">
  <!-- Architectural Security Banner inside Footer -->
  <div class="border-b border-surface-200/80 bg-surface-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-700 flex items-center justify-center flex-shrink-0 border border-emerald-200/70">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
            </svg>
          </div>
          <div>
            <span class="text-xs font-bold text-surface-900">Zero Server Uploads &bull; Client-Side Sandbox</span>
            <p class="text-[11px] text-surface-500 mt-0.5">Every conversion executes strictly inside browser RAM. Files never leave your local hardware.</p>
          </div>
        </div>
        <div class="flex items-center gap-4 text-xs font-mono text-surface-500">
          <span class="inline-flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            No Cloud Storage
          </span>
          <span class="inline-flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            No Registration
          </span>
          <span class="inline-flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            No Rate Limits
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- Full Tool Directory Matrix -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-8">
      <!-- Site Summary Col -->
      <div class="col-span-2 md:col-span-4 lg:col-span-1">
        <a href="/" class="inline-flex items-center gap-2 mb-3 focus-visible:outline-brand-500 rounded-lg">
          <BrandLogo size="sm" showWordmark={true} />
        </a>
        <p class="text-xs text-surface-500 leading-relaxed mb-4">
          Fast, open-architecture client-side conversion utilities engineered for privacy, speed, and zero server roundtrips.
        </p>
        <p class="text-[11px] text-surface-400 font-mono">
          Powered by WebAssembly, Web Audio API &amp; HTML5 Canvas.
        </p>
      </div>

      <!-- Categories & Tools Columns for SEO Crawlability -->
      {categories.map((cat) => {
        const tools = getToolsByCategory(cat.id);
        return (
          <div>
            <a href={`/${cat.id}`} class="text-xs font-bold text-surface-900 uppercase tracking-wider hover:text-brand-600 focus-visible:outline-brand-500 transition-colors block mb-3">
              {cat.name}
            </a>
            <ul class="space-y-2 text-xs">
              {tools.length > 0 ? (
                tools.map((tool) => (
                  <li>
                    <a
                      href={`/${tool.category}/${tool.slug}`}
                      class="text-surface-600 hover:text-brand-600 focus-visible:outline-brand-500 transition-colors inline-flex items-center gap-1"
                    >
                      <span>{tool.title}</span>
                      {tool.status === 'coming-soon' && (
                        <span class="text-[9px] uppercase px-1 py-0.5 rounded bg-surface-100 text-surface-500 font-semibold">Soon</span>
                      )}
                    </a>
                  </li>
                ))
              ) : (
                <li class="text-surface-400 italic">Tools arriving in next release</li>
              )}
            </ul>
          </div>
        );
      })}
    </div>

    <!-- Bottom copyright -->
    <div class="mt-12 pt-8 border-t border-surface-200 text-center sm:flex sm:justify-between sm:text-left text-xs text-surface-400">
      <p>&copy; {new Date().getFullYear()} PureFile. Built for speed and total privacy.</p>
      <p class="mt-2 sm:mt-0">All operations are executed 100% on your local hardware.</p>
    </div>
  </div>
</footer>
