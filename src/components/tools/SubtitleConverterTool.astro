---
import FileDropzone from '../FileDropzone.astro';
import type { Tool } from '../../data/tools';

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
---

<div id="subtitle-converter-root" class="w-full space-y-6">
  <!-- Interactive Dropzone -->
  <FileDropzone
    toolTitle={tool.title}
    acceptedFiles={tool.acceptedFiles}
    acceptedTypesLabel={tool.acceptedTypesLabel}
    sizeWarningMB={tool.sizeWarningMB}
    sizeCeilingNote={tool.sizeCeilingNote}
    status={tool.status}
    multiple={false}
    managedExternally={true}
  />

  <!-- Main Active Workspace: Hidden until file is loaded -->
  <div id="sub-workspace-section" class="hidden space-y-6">
    <!-- Subtitle Summary Card -->
    <div class="p-4 sm:p-5 rounded-2xl bg-surface-50 border border-surface-200/80 space-y-3">
      <div class="flex flex-wrap items-center justify-between gap-3 pb-3 border-b border-surface-200/60">
        <div class="flex items-center gap-3 min-w-0">
          <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" />
            </svg>
          </div>
          <div class="min-w-0">
            <p id="sub-filename" class="text-xs sm:text-sm font-bold text-surface-900 truncate">subtitles.srt</p>
            <p id="sub-filesize" class="text-[11px] text-surface-500">0 KB</p>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <button
            id="sub-clear-btn"
            type="button"
            class="px-3 py-1.5 rounded-lg border border-surface-200 bg-white hover:bg-rose-50 hover:text-rose-600 text-surface-600 font-semibold text-xs transition-colors focus-visible:outline-brand-500"
          >
            Clear File
          </button>
        </div>
      </div>

      <!-- Metadata Badges -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs">
        <div class="p-2.5 rounded-xl bg-white border border-surface-200">
          <span class="text-[10px] uppercase font-bold text-surface-400 block tracking-wider">Detected Format</span>
          <span id="sub-detected-badge" class="font-bold text-surface-800 text-xs sm:text-sm uppercase">SRT</span>
        </div>
        <div class="p-2.5 rounded-xl bg-white border border-surface-200">
          <span class="text-[10px] uppercase font-bold text-surface-400 block tracking-wider">Total Cues</span>
          <span id="sub-cue-count" class="font-bold text-surface-800 text-xs sm:text-sm">0 cues</span>
        </div>
        <div class="p-2.5 rounded-xl bg-white border border-surface-200">
          <span class="text-[10px] uppercase font-bold text-surface-400 block tracking-wider">Total Duration</span>
          <span id="sub-duration" class="font-bold text-surface-800 text-xs sm:text-sm">00:00:00</span>
        </div>
        <div class="p-2.5 rounded-xl bg-white border border-surface-200">
          <span class="text-[10px] uppercase font-bold text-surface-400 block tracking-wider">Timing Status</span>
          <span id="sub-timing-status" class="font-bold text-emerald-600 text-xs sm:text-sm">Valid Timecodes</span>
        </div>
      </div>
    </div>

    <!-- Validation Warnings / Info Notice -->
    <div
      id="sub-warning-banner"
      class="hidden p-4 rounded-2xl bg-amber-50 border border-amber-200 text-amber-900 text-xs flex items-start gap-3 transition-all"
      role="alert"
    >
      <svg class="w-5 h-5 text-amber-600 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <div class="space-y-1">
        <p class="font-semibold text-amber-950" id="sub-warning-title">Subtitle Notices</p>
        <ul id="sub-warning-list" class="list-disc pl-4 space-y-0.5 text-amber-800">
          <!-- Dynamically populated warnings -->
        </ul>
      </div>
    </div>

    <!-- Conversion Configuration Options -->
    <div class="p-5 rounded-2xl bg-surface-50 border border-surface-200/80 space-y-4">
      <div class="flex items-center gap-2 pb-2 border-b border-surface-200/60">
        <svg class="w-4 h-4 text-brand-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
        </svg>
        <span class="text-xs font-bold uppercase tracking-wider text-surface-700">Conversion & Output Settings</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 text-xs">
        <!-- Target Format Selection -->
        <div class="space-y-1.5">
          <label for="sub-target-format" class="font-semibold text-surface-900 block">Target Format</label>
          <select
            id="sub-target-format"
            class="w-full px-3 py-2 rounded-xl bg-white border border-surface-200 text-surface-800 font-medium focus:border-brand-500 focus:outline-none transition-colors"
            aria-label="Target Subtitle Format"
          >
            <option value="vtt" selected>WebVTT (.vtt) — Web & HTML5 video</option>
            <option value="srt">SubRip (.srt) — Desktop & VLC players</option>
            <option value="txt">Plain Text (.txt) — Dialogue transcript</option>
          </select>
        </div>

        <!-- TXT Extraction Mode (Only visible when TXT format chosen) -->
        <div id="sub-txt-mode-container" class="space-y-1.5 hidden">
          <label for="sub-txt-mode" class="font-semibold text-surface-900 block">Text Output Style</label>
          <select
            id="sub-txt-mode"
            class="w-full px-3 py-2 rounded-xl bg-white border border-surface-200 text-surface-800 font-medium focus:border-brand-500 focus:outline-none transition-colors"
            aria-label="Plain Text Output Style"
          >
            <option value="cues" selected>One cue per line</option>
            <option value="paragraphs">Group as dialogue paragraphs</option>
          </select>
        </div>

        <!-- Output Filename -->
        <div class="space-y-1.5">
          <label for="sub-output-filename" class="font-semibold text-surface-900 block">Output Filename</label>
          <input
            id="sub-output-filename"
            type="text"
            value="subtitles.vtt"
            placeholder="subtitles.vtt"
            class="w-full px-3 py-2 rounded-xl bg-white border border-surface-200 text-surface-800 focus:border-brand-500 focus:outline-none transition-colors truncate"
            aria-label="Output Subtitle Filename"
          />
        </div>
      </div>
    </div>

    <!-- Live Subtitle Editor & Textarea Preview -->
    <div class="space-y-2">
      <div class="flex items-center justify-between gap-2">
        <div class="flex items-center gap-2">
          <span class="text-xs font-bold uppercase tracking-wider text-surface-700">Subtitle Content Editor</span>
          <span class="text-[10px] px-2 py-0.5 rounded-full bg-brand-50 text-brand-700 font-semibold">Editable</span>
        </div>
        <div class="flex items-center gap-2">
          <button
            id="sub-reset-btn"
            type="button"
            class="text-[11px] font-semibold text-surface-500 hover:text-brand-600 transition-colors focus-visible:outline-brand-500"
          >
            Reset to Original
          </button>
        </div>
      </div>

      <div class="relative">
        <textarea
          id="sub-editor-textarea"
          class="w-full h-64 sm:h-80 p-3.5 rounded-2xl bg-surface-900 text-surface-100 font-mono text-xs leading-relaxed border border-surface-700 focus:border-brand-500 focus:ring-1 focus:ring-brand-500 focus:outline-none resize-y selection:bg-brand-600 selection:text-white"
          placeholder="Paste or edit subtitle cues here..."
          aria-label="Subtitle cue editor and preview"
          spellcheck="false"
        ></textarea>
      </div>
      <p class="text-[11px] text-surface-500">
        You can make manual text edits or fix broken timestamps directly in the editor above. Conversion will validate and export your updated text.
      </p>
    </div>

    <!-- Action Bar: Convert & Download -->
    <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
      <div class="flex items-center gap-3">
        <button
          id="sub-convert-btn"
          type="button"
          class="px-6 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 active:bg-brand-800 text-white font-semibold text-xs shadow-sm transition-all flex items-center gap-2 focus-visible:outline-brand-500"
        >
          <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          Convert Subtitles
        </button>

        <button
          id="sub-download-btn"
          type="button"
          class="hidden px-6 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white font-semibold text-xs shadow-sm transition-all flex items-center gap-2 focus-visible:outline-emerald-500"
        >
          <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          Download <span id="sub-download-ext-label">VTT</span>
        </button>
      </div>

      <span id="sub-status-msg" class="text-xs text-surface-500 font-medium" role="status" aria-live="polite">
        Ready to convert
      </span>
    </div>

    <!-- Success Result Card -->
    <div id="sub-result-card" class="hidden p-4 sm:p-5 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-950 space-y-3">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-3 min-w-0">
          <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <div class="min-w-0">
            <p class="font-bold text-xs sm:text-sm text-emerald-900 truncate" id="sub-result-filename">subtitles.vtt</p>
            <p class="text-[11px] text-emerald-700" id="sub-result-info">Converted successfully • 0 KB • UTF-8</p>
          </div>
        </div>

        <button
          id="sub-download-result-btn"
          type="button"
          class="px-5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white font-semibold text-xs shadow-xs transition-all flex items-center gap-2 focus-visible:outline-emerald-500"
        >
          <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          Download File
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import {
    parseSubtitles,
    serializeToSrt,
    serializeToVtt,
    serializeToTxt,
    generateSubtitleFilename,
    downloadSubtitleText,
    type SubtitleFormat,
    type SubtitleParseResult,
  } from '../../scripts/subtitle-converter';

  const root = document.getElementById('subtitle-converter-root');

  if (root) {
    const workspaceSection = root.querySelector<HTMLElement>('#sub-workspace-section')!;
    const filenameLabel = root.querySelector<HTMLElement>('#sub-filename')!;
    const filesizeLabel = root.querySelector<HTMLElement>('#sub-filesize')!;
    const detectedBadge = root.querySelector<HTMLElement>('#sub-detected-badge')!;
    const cueCountLabel = root.querySelector<HTMLElement>('#sub-cue-count')!;
    const durationLabel = root.querySelector<HTMLElement>('#sub-duration')!;
    const timingStatus = root.querySelector<HTMLElement>('#sub-timing-status')!;
    const clearBtn = root.querySelector<HTMLButtonElement>('#sub-clear-btn')!;

    const warningBanner = root.querySelector<HTMLElement>('#sub-warning-banner')!;
    const warningTitle = root.querySelector<HTMLElement>('#sub-warning-title')!;
    const warningList = root.querySelector<HTMLUListElement>('#sub-warning-list')!;

    const targetFormatSelect = root.querySelector<HTMLSelectElement>('#sub-target-format')!;
    const txtModeContainer = root.querySelector<HTMLElement>('#sub-txt-mode-container')!;
    const txtModeSelect = root.querySelector<HTMLSelectElement>('#sub-txt-mode')!;
    const outputFilenameInput = root.querySelector<HTMLInputElement>('#sub-output-filename')!;

    const editorTextarea = root.querySelector<HTMLTextAreaElement>('#sub-editor-textarea')!;
    const resetBtn = root.querySelector<HTMLButtonElement>('#sub-reset-btn')!;

    const convertBtn = root.querySelector<HTMLButtonElement>('#sub-convert-btn')!;
    const downloadBtn = root.querySelector<HTMLButtonElement>('#sub-download-btn')!;
    const downloadExtLabel = root.querySelector<HTMLElement>('#sub-download-ext-label')!;
    const statusMsg = root.querySelector<HTMLElement>('#sub-status-msg')!;

    const resultCard = root.querySelector<HTMLElement>('#sub-result-card')!;
    const resultFilename = root.querySelector<HTMLElement>('#sub-result-filename')!;
    const resultInfo = root.querySelector<HTMLElement>('#sub-result-info')!;
    const downloadResultBtn = root.querySelector<HTMLButtonElement>('#sub-download-result-btn')!;

    // State
    let originalFile: File | null = null;
    let originalRawText: string = '';
    let currentParseResult: SubtitleParseResult | null = null;
    let lastConvertedText: string = '';
    let lastConvertedFilename: string = '';
    let lastConvertedFormat: SubtitleFormat = 'vtt';

    function formatBytes(bytes: number): string {
      if (bytes === 0) return '0 Bytes';
      const k = 1024;
      const sizes = ['Bytes', 'KB', 'MB', 'GB'];
      const i = Math.floor(Math.log(bytes) / Math.log(k));
      return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
    }

    function formatDuration(ms: number): string {
      if (ms <= 0) return '00:00:00';
      const s = Math.floor(ms / 1000);
      const secs = s % 60;
      const mins = Math.floor((s / 60) % 60);
      const hrs = Math.floor(s / 3600);
      const pad = (n: number) => String(n).padStart(2, '0');
      return `${pad(hrs)}:${pad(mins)}:${pad(secs)}`;
    }

    function updateWarnings(warnings: string[], isTxtWithoutTiming: boolean) {
      warningList.innerHTML = '';
      if (isTxtWithoutTiming) {
        warningTitle.textContent = 'Plain text without subtitle timing';
        const li = document.createElement('li');
        li.textContent = 'Plain TXT files do not contain subtitle timing metadata. Timed subtitles cannot be inferred automatically. You can export plain text or add timestamps before exporting to SRT or VTT.';
        warningList.appendChild(li);
        warningBanner.classList.remove('hidden');
        return;
      }

      if (warnings.length > 0) {
        warningTitle.textContent = `Subtitle Notices (${warnings.length} issues detected)`;
        warnings.forEach((w) => {
          const li = document.createElement('li');
          li.textContent = w;
          warningList.appendChild(li);
        });
        warningBanner.classList.remove('hidden');
      } else {
        warningBanner.classList.add('hidden');
      }
    }

    function updateFormatOptions(detectedFormat: 'srt' | 'vtt' | 'txt', hasTimestamps: boolean) {
      targetFormatSelect.innerHTML = '';

      if (detectedFormat === 'srt') {
        const optVtt = new Option('WebVTT (.vtt) — Web & HTML5 video', 'vtt', true, true);
        const optTxt = new Option('Plain Text (.txt) — Dialogue transcript', 'txt');
        const optSrt = new Option('SubRip (.srt) — Normalized / Cleaned', 'srt');
        targetFormatSelect.add(optVtt);
        targetFormatSelect.add(optTxt);
        targetFormatSelect.add(optSrt);
      } else if (detectedFormat === 'vtt') {
        const optSrt = new Option('SubRip (.srt) — Desktop & VLC players', 'srt', true, true);
        const optTxt = new Option('Plain Text (.txt) — Dialogue transcript', 'txt');
        const optVtt = new Option('WebVTT (.vtt) — Normalized / Cleaned', 'vtt');
        targetFormatSelect.add(optSrt);
        targetFormatSelect.add(optTxt);
        targetFormatSelect.add(optVtt);
      } else {
        // TXT format
        if (hasTimestamps) {
          const optVtt = new Option('WebVTT (.vtt) — Web & HTML5 video', 'vtt', true, true);
          const optSrt = new Option('SubRip (.srt) — Desktop & VLC players', 'srt');
          const optTxt = new Option('Plain Text (.txt) — Clean dialogue', 'txt');
          targetFormatSelect.add(optVtt);
          targetFormatSelect.add(optSrt);
          targetFormatSelect.add(optTxt);
        } else {
          const optTxt = new Option('Plain Text (.txt) — Clean transcript', 'txt', true, true);
          targetFormatSelect.add(optTxt);
        }
      }

      updateTargetFormatDisplay();
    }

    function updateTargetFormatDisplay() {
      const selected = targetFormatSelect.value as SubtitleFormat;
      if (selected === 'txt') {
        txtModeContainer.classList.remove('hidden');
      } else {
        txtModeContainer.classList.add('hidden');
      }

      if (originalFile) {
        outputFilenameInput.value = generateSubtitleFilename(originalFile.name, selected);
      }
      downloadExtLabel.textContent = selected.toUpperCase();
    }

    function handleLoadedFile(file: File) {
      originalFile = file;
      filenameLabel.textContent = file.name;
      filesizeLabel.textContent = formatBytes(file.size);

      const reader = new FileReader();
      reader.onload = (e) => {
        const text = (e.target?.result as string) || '';
        originalRawText = text;
        editorTextarea.value = text;
        parseAndRender(true);
        workspaceSection.classList.remove('hidden');
        workspaceSection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      };
      reader.readAsText(file, 'utf-8');
    }

    function parseAndRender(isNewFile = false) {
      const currentText = editorTextarea.value;
      const parsed = parseSubtitles(currentText, originalFile?.name);
      currentParseResult = parsed;

      detectedBadge.textContent = parsed.format.toUpperCase();
      cueCountLabel.textContent = `${parsed.cues.length} cues`;
      durationLabel.textContent = formatDuration(parsed.totalDurationMs);

      const isTxtWithoutTiming = parsed.format === 'txt' && !parsed.hasTimestamps;

      if (isTxtWithoutTiming) {
        timingStatus.textContent = 'No Timestamps';
        timingStatus.className = 'font-bold text-amber-600 text-xs sm:text-sm';
      } else if (parsed.warnings.length > 0) {
        timingStatus.textContent = 'Timing Warnings';
        timingStatus.className = 'font-bold text-amber-600 text-xs sm:text-sm';
      } else {
        timingStatus.textContent = 'Valid Timecodes';
        timingStatus.className = 'font-bold text-emerald-600 text-xs sm:text-sm';
      }

      updateWarnings(parsed.warnings, isTxtWithoutTiming);

      const currentVal = targetFormatSelect.value;
      updateFormatOptions(parsed.format, parsed.hasTimestamps);

      if (!isNewFile && currentVal && Array.from(targetFormatSelect.options).some((o) => o.value === currentVal)) {
        targetFormatSelect.value = currentVal;
      }

      updateTargetFormatDisplay();

      // Reset result card when re-editing
      resultCard.classList.add('hidden');
      downloadBtn.classList.add('hidden');
      statusMsg.textContent = 'Ready to convert';
      statusMsg.className = 'text-xs text-surface-500 font-medium';
    }

    function convertSubtitles(): boolean {
      if (!currentParseResult) return false;
      const targetFormat = targetFormatSelect.value as SubtitleFormat;
      let output = '';

      if (targetFormat === 'txt') {
        const mode = (txtModeSelect.value as 'cues' | 'paragraphs') || 'cues';
        if (currentParseResult.cues.length > 0) {
          output = serializeToTxt(currentParseResult.cues, mode);
        } else {
          output = currentParseResult.rawText.trim();
        }
      } else if (targetFormat === 'vtt') {
        if (currentParseResult.cues.length === 0 && !currentParseResult.hasTimestamps) {
          statusMsg.textContent = 'Cannot convert to WebVTT: File does not contain subtitle timestamps.';
          statusMsg.className = 'text-xs text-rose-600 font-semibold';
          return false;
        }
        output = serializeToVtt(currentParseResult.cues);
      } else if (targetFormat === 'srt') {
        if (currentParseResult.cues.length === 0 && !currentParseResult.hasTimestamps) {
          statusMsg.textContent = 'Cannot convert to SubRip (SRT): File does not contain subtitle timestamps.';
          statusMsg.className = 'text-xs text-rose-600 font-semibold';
          return false;
        }
        output = serializeToSrt(currentParseResult.cues);
      }

      lastConvertedText = output;
      lastConvertedFormat = targetFormat;
      const fallbackName = originalFile ? originalFile.name : 'subtitles';
      lastConvertedFilename = outputFilenameInput.value.trim() || generateSubtitleFilename(fallbackName, targetFormat);

      // Render Result Card
      resultFilename.textContent = lastConvertedFilename;
      const byteLen = new TextEncoder().encode(output).length;
      resultInfo.textContent = `Converted to ${targetFormat.toUpperCase()} • ${formatBytes(byteLen)} • UTF-8`;
      resultCard.classList.remove('hidden');

      downloadBtn.classList.remove('hidden');
      downloadExtLabel.textContent = targetFormat.toUpperCase();

      statusMsg.textContent = 'Conversion complete! Ready to download.';
      statusMsg.className = 'text-xs text-emerald-600 font-semibold';
      return true;
    }

    function triggerDownload() {
      if (!lastConvertedText) {
        const success = convertSubtitles();
        if (!success) return;
      }
      downloadSubtitleText(lastConvertedText, lastConvertedFilename, lastConvertedFormat);
      statusMsg.textContent = `Downloaded ${lastConvertedFilename}`;
      statusMsg.className = 'text-xs text-emerald-600 font-semibold';
    }

    // Event Listeners
    document.addEventListener('file-dropzone:files-selected', ((e: Event) => {
      const customEvent = e as CustomEvent<{ files: File[] }>;
      if (customEvent.detail.files && customEvent.detail.files.length > 0) {
        handleLoadedFile(customEvent.detail.files[0]);
      }
    }) as EventListener);

    targetFormatSelect.addEventListener('change', () => {
      updateTargetFormatDisplay();
    });

    editorTextarea.addEventListener('input', () => {
      parseAndRender();
    });

    resetBtn.addEventListener('click', () => {
      editorTextarea.value = originalRawText;
      parseAndRender();
    });

    clearBtn.addEventListener('click', () => {
      originalFile = null;
      originalRawText = '';
      currentParseResult = null;
      lastConvertedText = '';
      workspaceSection.classList.add('hidden');
      resultCard.classList.add('hidden');
      downloadBtn.classList.add('hidden');
      editorTextarea.value = '';
    });

    convertBtn.addEventListener('click', () => {
      convertSubtitles();
    });

    downloadBtn.addEventListener('click', () => {
      triggerDownload();
    });

    downloadResultBtn.addEventListener('click', () => {
      triggerDownload();
    });
  }
</script>
