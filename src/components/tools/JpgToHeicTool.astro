---
import FileDropzone from '../FileDropzone.astro';
import type { Tool } from '../../data/tools';

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
---

<div id="jpg-tool-root" class="w-full max-w-3xl mx-auto">
  <!-- 1. Dropzone File Selector -->
  <div id="dropzone-wrapper">
    <FileDropzone
      toolTitle={tool.title}
      acceptedFiles={tool.acceptedFiles}
      acceptedTypesLabel={tool.acceptedTypesLabel}
      sizeWarningMB={tool.sizeWarningMB}
      sizeCeilingNote={tool.sizeCeilingNote}
      status="active"
      multiple={true}
      managedExternally={true}
    />
  </div>

  <!-- 2. Quality Control & Settings Card -->
  <div class="mt-6 p-4 sm:p-5 rounded-2xl bg-white border border-surface-200/80 shadow-xs">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div>
        <label for="jpg-quality-slider" class="text-sm font-semibold text-surface-900 flex items-center gap-2">
          <span>Output HEIC Quality:</span>
          <span id="quality-display-badge" class="px-2 py-0.5 rounded-md bg-brand-50 text-brand-700 font-mono font-bold text-xs">
            85%
          </span>
        </label>
        <p class="text-xs text-surface-500 mt-1">
          Higher quality preserves fine texture; lower quality reduces storage size. Default 85% is recommended.
        </p>
      </div>

      <div class="w-full sm:w-48 flex items-center gap-3">
        <span class="text-xs text-surface-400 font-medium">50%</span>
        <input
          id="jpg-quality-slider"
          type="range"
          min="50"
          max="100"
          step="5"
          value="85"
          class="w-full h-2 bg-surface-200 rounded-lg appearance-none cursor-pointer accent-brand-600 focus-visible:outline-brand-500"
          aria-label="HEIC Output Quality"
          aria-valuemin="50"
          aria-valuemax="100"
          aria-valuenow="85"
        />
        <span class="text-xs text-surface-400 font-medium">100%</span>
      </div>
    </div>
  </div>

  <!-- 3. Memory Warning Banner -->
  <div
    id="batch-warning-banner"
    class="hidden mt-4 p-4 rounded-xl bg-amber-50 border border-amber-200/80 text-amber-900 text-xs sm:text-sm flex items-start gap-3"
  >
    <svg class="w-5 h-5 text-amber-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
    </svg>
    <div>
      <span class="font-semibold">Large Batch Notice:</span>
      <span id="batch-warning-text">You have selected over 50 MB of images. Conversion executes sequentially to conserve device memory.</span>
    </div>
  </div>

  <!-- 4. Queue / File List Card -->
  <div id="queue-section" class="hidden mt-6 p-4 sm:p-5 rounded-2xl bg-white border border-surface-200/80 shadow-xs">
    <div class="flex items-center justify-between pb-3 border-b border-surface-100">
      <div class="flex items-center gap-2">
        <h2 class="text-sm font-bold text-surface-900">Queued JPGs</h2>
        <span id="queue-count" class="px-2 py-0.5 text-xs font-semibold rounded-full bg-surface-100 text-surface-600">0</span>
        <span id="queue-total-size" class="text-xs text-surface-400">0 B</span>
      </div>

      <button
        type="button"
        id="clear-all-btn"
        class="text-xs font-semibold text-surface-500 hover:text-red-600 focus-visible:outline-red-500 transition-colors"
      >
        Clear All
      </button>
    </div>

    <!-- Items List -->
    <div id="queue-list" class="mt-3 space-y-2 max-h-64 overflow-y-auto pr-1">
      <!-- Dynamically filled by JS -->
    </div>

    <!-- Action Bar -->
    <div class="mt-5 pt-3 border-t border-surface-100 flex flex-col sm:flex-row items-center justify-between gap-3">
      <div class="text-xs text-surface-500 flex items-center gap-1.5">
        <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        <span>100% Client-Side WebAssembly</span>
      </div>

      <button
        type="button"
        id="start-convert-btn"
        class="w-full sm:w-auto px-6 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 active:bg-brand-800 text-white font-semibold text-sm shadow-sm hover:shadow transition-all focus-visible:outline-2 focus-visible:outline-brand-600 disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2"
      >
        <span id="convert-btn-text">Convert to HEIC</span>
      </button>
    </div>
  </div>

  <!-- 5. Conversion Progress Card -->
  <div
    id="progress-container"
    class="hidden mt-6 p-5 rounded-2xl bg-white border border-brand-200 shadow-sm"
    role="status"
    aria-live="polite"
  >
    <div class="flex items-center justify-between text-xs font-semibold mb-2">
      <span id="progress-status-text" class="text-brand-900 flex items-center gap-2">
        <svg class="animate-spin w-4 h-4 text-brand-600" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span>Converting images…</span>
      </span>
      <span id="progress-percentage-text" class="text-brand-600 font-mono">0%</span>
    </div>

    <div class="w-full bg-surface-100 rounded-full h-2.5 overflow-hidden">
      <div
        id="progress-bar-fill"
        class="bg-brand-600 h-2.5 rounded-full transition-all duration-300 ease-out"
        style="width: 0%"
      ></div>
    </div>
  </div>

  <!-- 6. Results Section -->
  <div id="results-section" class="hidden mt-6 p-4 sm:p-5 rounded-2xl bg-white border border-surface-200/80 shadow-xs">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-surface-100">
      <div class="flex items-center gap-2">
        <h2 class="text-sm font-bold text-surface-900">Converted HEIC Files</h2>
        <span id="results-count" class="px-2 py-0.5 text-xs font-semibold rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200/60">0</span>
      </div>

      <button
        type="button"
        id="download-zip-btn"
        class="hidden px-4 py-1.5 rounded-xl bg-surface-900 hover:bg-surface-800 text-white font-semibold text-xs transition-all focus-visible:outline-surface-900 flex items-center justify-center gap-1.5"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        <span>Download All as ZIP</span>
      </button>
    </div>

    <!-- Result Cards List -->
    <div id="results-list" class="mt-4 space-y-3 max-h-96 overflow-y-auto pr-1">
      <!-- Result cards dynamically inserted -->
    </div>
  </div>

  <!-- Cross-link to reverse tool -->
  <div class="mt-8 text-center text-xs text-surface-500">
    Need the reverse? <a href="/image/heic-to-jpg" class="font-medium text-brand-600 hover:text-brand-700 underline underline-offset-2">Convert HEIC to JPG</a>.
  </div>
</div>

<script>
  import {
    formatBytes,
    formatSizeDifference,
    convertJpgFile,
    downloadBlob,
    downloadAllAsZip,
    type QueueItem,
    type ConvertedResult,
  } from '../../scripts/jpg-to-heic';

  const root = document.getElementById('jpg-tool-root');

  if (root) {
    const qualitySlider = root.querySelector<HTMLInputElement>('#jpg-quality-slider')!;
    const qualityBadge = root.querySelector<HTMLElement>('#quality-display-badge')!;
    const batchWarningBanner = root.querySelector<HTMLElement>('#batch-warning-banner')!;
    const queueSection = root.querySelector<HTMLElement>('#queue-section')!;
    const queueList = root.querySelector<HTMLElement>('#queue-list')!;
    const queueCount = root.querySelector<HTMLElement>('#queue-count')!;
    const queueTotalSize = root.querySelector<HTMLElement>('#queue-total-size')!;
    const clearAllBtn = root.querySelector<HTMLButtonElement>('#clear-all-btn')!;
    const startConvertBtn = root.querySelector<HTMLButtonElement>('#start-convert-btn')!;
    const convertBtnText = root.querySelector<HTMLElement>('#convert-btn-text')!;
    const progressContainer = root.querySelector<HTMLElement>('#progress-container')!;
    const progressStatusText = root.querySelector<HTMLElement>('#progress-status-text')!;
    const progressPercentageText = root.querySelector<HTMLElement>('#progress-percentage-text')!;
    const progressBarFill = root.querySelector<HTMLElement>('#progress-bar-fill')!;
    const resultsSection = root.querySelector<HTMLElement>('#results-section')!;
    const resultsList = root.querySelector<HTMLElement>('#results-list')!;
    const resultsCount = root.querySelector<HTMLElement>('#results-count')!;
    const downloadZipBtn = root.querySelector<HTMLButtonElement>('#download-zip-btn')!;

    let queue: QueueItem[] = [];
    let isConverting = false;
    let activeObjectUrls: Set<string> = new Set();

    function revokeAllUrls() {
      activeObjectUrls.forEach((url) => URL.revokeObjectURL(url));
      activeObjectUrls.clear();
    }

    qualitySlider.addEventListener('input', () => {
      qualityBadge.textContent = `${qualitySlider.value}%`;
      qualitySlider.setAttribute('aria-valuenow', qualitySlider.value);
    });

    // Handle files dropped or picked from FileDropzone
    window.addEventListener('file-dropzone:files-selected', (e: Event) => {
      const customEvent = e as CustomEvent<{ files: File[] }>;
      if (!customEvent.detail || !customEvent.detail.files) return;

      const newFiles = Array.from(customEvent.detail.files).filter((file) => {
        const ext = file.name.toLowerCase();
        return ext.endsWith('.jpg') || ext.endsWith('.jpeg') || file.type === 'image/jpeg';
      });

      if (newFiles.length === 0) return;

      newFiles.forEach((file) => {
        const id = 'jpg_' + Math.random().toString(36).substring(2, 9);
        queue.push({
          id,
          file,
          status: 'ready',
        });
      });

      renderQueue();
    });

    clearAllBtn.addEventListener('click', () => {
      if (isConverting) return;
      queue = [];
      revokeAllUrls();
      renderQueue();
      resultsSection.classList.add('hidden');
      resultsList.innerHTML = '';
      progressContainer.classList.add('hidden');
      document.dispatchEvent(new CustomEvent('file-dropzone:reset'));
    });

    function renderQueue() {
      if (queue.length === 0) {
        queueSection.classList.add('hidden');
        batchWarningBanner.classList.add('hidden');
        return;
      }

      queueSection.classList.remove('hidden');
      queueCount.textContent = String(queue.length);

      const totalBytes = queue.reduce((acc, item) => acc + item.file.size, 0);
      queueTotalSize.textContent = formatBytes(totalBytes);

      if (totalBytes > 50 * 1024 * 1024) {
        batchWarningBanner.classList.remove('hidden');
      } else {
        batchWarningBanner.classList.add('hidden');
      }

      queueList.innerHTML = '';
      queue.forEach((item) => {
        const row = document.createElement('div');
        row.className =
          'p-2.5 sm:p-3 rounded-xl bg-surface-50 border border-surface-200/60 flex items-center justify-between gap-3 text-xs';
        row.id = `queue-item-${item.id}`;

        let statusBadge = '';
        if (item.status === 'ready') {
          statusBadge = '<span class="px-2 py-0.5 rounded-md bg-surface-200/80 text-surface-600 font-medium">Ready</span>';
        } else if (item.status === 'converting') {
          statusBadge = '<span class="px-2 py-0.5 rounded-md bg-brand-100 text-brand-700 font-medium animate-pulse">Converting…</span>';
        } else if (item.status === 'completed') {
          statusBadge = '<span class="px-2 py-0.5 rounded-md bg-emerald-100 text-emerald-800 font-medium">Completed</span>';
        } else if (item.status === 'failed') {
          statusBadge = `<span class="px-2 py-0.5 rounded-md bg-red-100 text-red-700 font-medium" title="${item.errorMessage || 'Failed'}">Error</span>`;
        }

        row.innerHTML = `
          <div class="min-w-0 flex-1">
            <p class="font-semibold text-surface-900 truncate" title="${item.file.name}">${item.file.name}</p>
            <p class="text-surface-400 mt-0.5">${formatBytes(item.file.size)}</p>
          </div>
          <div class="flex items-center gap-2 shrink-0">
            ${statusBadge}
            ${
              !isConverting && item.status === 'ready'
                ? `<button type="button" data-remove="${item.id}" class="p-1 text-surface-400 hover:text-surface-700 focus-visible:outline-brand-500 rounded" aria-label="Remove ${item.file.name}">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                  </button>`
                : ''
            }
          </div>
        `;

        const removeBtn = row.querySelector(`[data-remove="${item.id}"]`);
        if (removeBtn) {
          removeBtn.addEventListener('click', () => {
            queue = queue.filter((q) => q.id !== item.id);
            renderQueue();
          });
        }

        queueList.appendChild(row);
      });
    }

    startConvertBtn.addEventListener('click', async () => {
      const pendingItems = queue.filter((item) => item.status === 'ready');
      if (pendingItems.length === 0 || isConverting) return;

      isConverting = true;
      startConvertBtn.disabled = true;
      clearAllBtn.disabled = true;
      convertBtnText.textContent = 'Converting…';
      progressContainer.classList.remove('hidden');

      const qualityVal = parseInt(qualitySlider.value, 10);
      const convertedResults: ConvertedResult[] = [];
      const totalToConvert = pendingItems.length;
      let completedCount = 0;

      for (let i = 0; i < pendingItems.length; i++) {
        const item = pendingItems[i];
        item.status = 'converting';
        renderQueue();

        const pct = Math.round((i / totalToConvert) * 100);
        progressPercentageText.textContent = `${pct}%`;
        progressBarFill.style.width = `${pct}%`;
        progressStatusText.querySelector('span')!.textContent = `Converting file ${i + 1} of ${totalToConvert} (${item.file.name})…`;

        try {
          const { blob, width, height } = await convertJpgFile(
            item.file,
            qualityVal,
            (statusMsg) => {
              progressStatusText.querySelector('span')!.textContent = `[${i + 1}/${totalToConvert}] ${statusMsg}`;
            }
          );

          item.status = 'completed';
          const baseName = item.file.name.replace(/\.[^/.]+$/, '');
          const heicFileName = `${baseName}.heic`;
          const objectUrl = URL.createObjectURL(blob);
          activeObjectUrls.add(objectUrl);

          const result: ConvertedResult = {
            id: item.id,
            sourceFileName: item.file.name,
            sourceSize: item.file.size,
            heicFileName,
            heicSize: blob.size,
            width,
            height,
            blob,
            objectUrl,
          };

          convertedResults.push(result);
          appendResultCard(result);
        } catch (err: any) {
          console.error('Failed to convert', item.file.name, err);
          item.status = 'failed';
          item.errorMessage = err?.message || 'Unsupported image or encoding failure.';
          appendErrorCard(item);
        }

        completedCount++;
        renderQueue();
      }

      progressPercentageText.textContent = '100%';
      progressBarFill.style.width = '100%';
      progressStatusText.querySelector('span')!.textContent = 'All conversions completed!';

      setTimeout(() => {
        progressContainer.classList.add('hidden');
      }, 1500);

      isConverting = false;
      startConvertBtn.disabled = false;
      clearAllBtn.disabled = false;
      convertBtnText.textContent = 'Convert to HEIC';

      if (convertedResults.length > 1) {
        downloadZipBtn.classList.remove('hidden');
        downloadZipBtn.onclick = () => downloadAllAsZip(convertedResults);
      } else {
        downloadZipBtn.classList.add('hidden');
      }
    });

    function appendResultCard(res: ConvertedResult) {
      resultsSection.classList.remove('hidden');
      const currentCards = resultsList.querySelectorAll('.result-card').length + 1;
      resultsCount.textContent = String(currentCards);

      const diff = formatSizeDifference(res.sourceSize, res.heicSize);
      const diffBadge = diff.isSmaller
        ? `<span class="px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-700 font-medium text-xs border border-emerald-200/50">${diff.text}</span>`
        : `<span class="px-2 py-0.5 rounded-md bg-surface-100 text-surface-600 font-medium text-xs">${diff.text}</span>`;

      const card = document.createElement('div');
      card.className =
        'result-card p-3 sm:p-4 rounded-xl bg-surface-50 border border-surface-200/80 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs transition-all';
      card.id = `result-${res.id}`;

      card.innerHTML = `
        <div class="flex items-center gap-3 min-w-0">
          <div class="w-12 h-12 rounded-lg bg-surface-200/70 shrink-0 overflow-hidden flex items-center justify-center border border-surface-200">
            <svg class="w-6 h-6 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <div class="min-w-0">
            <p class="font-semibold text-surface-900 truncate" title="${res.heicFileName}">${res.heicFileName}</p>
            <div class="flex items-center gap-2 mt-0.5 text-surface-500 flex-wrap">
              <span>${res.width} × ${res.height}</span>
              <span>•</span>
              <span>${formatBytes(res.sourceSize)} → ${formatBytes(res.heicSize)}</span>
              ${diffBadge}
            </div>
          </div>
        </div>

        <button
          type="button"
          data-download="${res.id}"
          class="w-full sm:w-auto px-4 py-2 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-semibold text-xs shadow-2xs hover:shadow transition-all focus-visible:outline-brand-600 flex items-center justify-center gap-1.5 shrink-0"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span>Download HEIC</span>
        </button>
      `;

      card.querySelector(`[data-download="${res.id}"]`)!.addEventListener('click', () => {
        downloadBlob(res.blob, res.heicFileName);
      });

      resultsList.appendChild(card);
    }

    function appendErrorCard(item: QueueItem) {
      resultsSection.classList.remove('hidden');
      const card = document.createElement('div');
      card.className =
        'error-card p-3 sm:p-4 rounded-xl bg-red-50/60 border border-red-200/80 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs';
      card.innerHTML = `
        <div class="flex items-center gap-3 min-w-0">
          <div class="w-10 h-10 rounded-lg bg-red-100 text-red-600 shrink-0 flex items-center justify-center">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div class="min-w-0">
            <p class="font-semibold text-surface-900 truncate">${item.file.name}</p>
            <p class="text-red-600 mt-0.5">${item.errorMessage || 'Conversion failed'}</p>
          </div>
        </div>
        <span class="px-2 py-0.5 rounded-md bg-red-100 text-red-800 font-semibold text-xs shrink-0 self-start sm:self-center">Failed</span>
      `;
      resultsList.appendChild(card);
    }
  }
</script>
