---
import FileDropzone from '../FileDropzone.astro';
import type { Tool } from '../../data/tools';

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
---

<div id="video-compressor-root" class="w-full max-w-3xl mx-auto">
  <!-- 1. Dropzone File Selector -->
  <div id="video-dropzone-wrapper">
    <FileDropzone
      toolTitle={tool.title}
      acceptedFiles={tool.acceptedFiles}
      acceptedTypesLabel={tool.acceptedTypesLabel}
      sizeWarningMB={tool.sizeWarningMB}
      sizeCeilingNote={tool.sizeCeilingNote}
      status="active"
      multiple={false}
      managedExternally={true}
    />
  </div>

  <!-- 2. Selected Video Configuration Card (Hidden until video selected) -->
  <div id="video-config-card" class="hidden mt-6 rounded-2xl bg-white border border-surface-200/80 p-5 sm:p-6 shadow-xs">
    <!-- Header with filename and clear button -->
    <div class="flex items-center justify-between pb-4 border-b border-surface-100">
      <div class="flex items-center gap-2 overflow-hidden pr-2">
        <span class="p-1.5 rounded-lg bg-indigo-50 text-indigo-600 flex-shrink-0">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="m15.75 10.5 4.72-4.72a.75.75 0 0 1 1.28.53v11.38a.75.75 0 0 1-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 0 0 2.25-2.25v-9a2.25 2.25 0 0 0-2.25-2.25h-9A2.25 2.25 0 0 0 2.25 7.5v9a2.25 2.25 0 0 0 2.25 2.25Z" />
          </svg>
        </span>
        <h3 id="video-filename" class="text-sm font-bold text-surface-900 truncate">
          video.mp4
        </h3>
      </div>
      <button
        id="video-clear-btn"
        type="button"
        class="text-xs font-medium text-surface-500 hover:text-rose-600 transition-colors focus-visible:outline-brand-500"
      >
        Change Video
      </button>
    </div>

    <!-- Video Preview & Metadata Grid -->
    <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-4 items-center">
      <!-- Local Preview Player -->
      <div class="rounded-xl overflow-hidden bg-black/90 aspect-video flex items-center justify-center relative shadow-inner">
        <video
          id="source-video-preview"
          controls
          preload="metadata"
          playsinline
          class="w-full h-full object-contain max-h-48"
        ></video>
        <div id="video-preview-fallback" class="hidden absolute inset-0 flex flex-col items-center justify-center p-3 text-center bg-surface-900 text-surface-300">
          <svg class="w-8 h-8 text-surface-400 mb-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="m15.75 10.5 4.72-4.72a.75.75 0 0 1 1.28.53v11.38a.75.75 0 0 1-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 0 0 2.25-2.25v-9a2.25 2.25 0 0 0-2.25-2.25h-9A2.25 2.25 0 0 0 2.25 7.5v9a2.25 2.25 0 0 0 2.25 2.25Z" />
          </svg>
          <p class="text-xs font-medium">QuickTime MOV Preview</p>
          <p class="text-[10px] text-surface-400 mt-0.5">Native browser playback unavailable. Video will compress directly via FFmpeg.</p>
        </div>
      </div>

      <!-- Metadata summary -->
      <div class="space-y-2 text-xs">
        <div class="p-2.5 rounded-lg bg-surface-50 border border-surface-200/60 flex justify-between items-center">
          <span class="text-surface-500 font-medium">Original File Size:</span>
          <span id="meta-file-size" class="font-bold text-surface-800 font-mono">--</span>
        </div>
        <div class="p-2.5 rounded-lg bg-surface-50 border border-surface-200/60 flex justify-between items-center">
          <span class="text-surface-500 font-medium">Duration:</span>
          <span id="meta-duration" class="font-bold text-surface-800 font-mono">--</span>
        </div>
        <div class="p-2.5 rounded-lg bg-surface-50 border border-surface-200/60 flex justify-between items-center">
          <span class="text-surface-500 font-medium">Original Resolution:</span>
          <span id="meta-resolution" class="font-bold text-surface-800 font-mono">--</span>
        </div>
        <div class="p-2.5 rounded-lg bg-surface-50 border border-surface-200/60 flex justify-between items-center">
          <span class="text-surface-500 font-medium">Container Format:</span>
          <span id="meta-format" class="font-bold text-surface-800 font-mono">--</span>
        </div>
      </div>
    </div>

    <!-- Compression Controls Form -->
    <div class="mt-6 pt-5 border-t border-surface-100 space-y-4">
      <!-- Target File Size Control -->
      <div>
        <div class="flex items-center justify-between gap-2 mb-1.5">
          <label for="target-size-input" class="text-xs font-bold text-surface-900 flex items-center gap-1.5">
            <span>Target File Size:</span>
          </label>
          <span class="text-[11px] text-surface-500 font-medium">Output target in Megabytes</span>
        </div>

        <div class="flex items-center gap-3">
          <div class="relative flex-1 max-w-xs">
            <input
              id="target-size-input"
              type="number"
              min="0.01"
              max="500"
              step="any"
              value="25"
              class="w-full px-3.5 py-2 text-sm font-semibold rounded-xl border border-surface-300 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 pr-12 text-surface-900"
              aria-label="Target file size in megabytes"
            />
            <span class="absolute right-3.5 top-1/2 -translate-y-1/2 text-xs font-bold text-surface-400">MB</span>
          </div>

          <!-- Quick presets -->
          <div class="flex flex-wrap items-center gap-1.5">
            <button type="button" class="preset-btn px-2.5 py-1.5 text-xs font-medium rounded-lg bg-surface-100 hover:bg-surface-200 text-surface-700 transition-colors" data-target="10">10 MB</button>
            <button type="button" class="preset-btn px-2.5 py-1.5 text-xs font-semibold rounded-lg bg-brand-50 text-brand-700 border border-brand-200 hover:bg-brand-100 transition-colors" data-target="25">25 MB</button>
            <button type="button" class="preset-btn px-2.5 py-1.5 text-xs font-medium rounded-lg bg-surface-100 hover:bg-surface-200 text-surface-700 transition-colors" data-target="50">50 MB</button>
            <button type="button" class="preset-btn px-2.5 py-1.5 text-xs font-medium rounded-lg bg-surface-100 hover:bg-surface-200 text-surface-700 transition-colors" data-target="100">100 MB</button>
          </div>
        </div>
      </div>

      <!-- Resolution Selector -->
      <div>
        <label for="resolution-select" class="block text-xs font-bold text-surface-900 mb-1.5">
          Resolution Scaling:
        </label>
        <select
          id="resolution-select"
          class="w-full sm:max-w-xs px-3 py-2 text-xs font-medium rounded-xl border border-surface-300 bg-white text-surface-800 focus:ring-2 focus:ring-brand-500 focus:border-brand-500"
          aria-label="Video Resolution Scaling"
        >
          <option value="original" selected>Keep original resolution</option>
          <option value="1080p">1080p (1920 × 1080 max)</option>
          <option value="720p">720p (1280 × 720 max)</option>
          <option value="480p">480p (854 × 480 max)</option>
        </select>
        <p class="text-[11px] text-surface-500 mt-1">Aspect ratio is strictly preserved. Videos are never upscaled.</p>
      </div>

      <!-- Dynamic Budget Preview & Warnings -->
      <div id="budget-preview-banner" class="p-3 rounded-xl bg-surface-50 border border-surface-200 text-xs text-surface-600 flex items-center justify-between">
        <span class="font-medium">Calculated Video Bitrate:</span>
        <span id="calculated-bitrate-display" class="font-mono font-bold text-surface-800">~1,250 kbps</span>
      </div>

      <div id="target-warning-banner" class="hidden p-3 rounded-xl bg-amber-50 border border-amber-200 text-amber-900 text-xs flex items-start gap-2">
        <svg class="w-4 h-4 text-amber-600 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
        </svg>
        <span id="target-warning-text">Target size warning</span>
      </div>

      <!-- Large File Device Notice -->
      <div id="large-file-notice" class="hidden p-3 rounded-xl bg-blue-50 border border-blue-200 text-blue-900 text-xs flex items-start gap-2">
        <svg class="w-4 h-4 text-blue-600 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" />
        </svg>
        <span><strong>Device Memory Notice:</strong> Large videos (>100 MB) execute in browser RAM and require more CPU time. Keep other browser tabs minimal for peak performance.</span>
      </div>
    </div>

    <!-- Compression Progress Bar (Hidden until active) -->
    <div id="compression-progress-container" class="hidden mt-6 pt-4 border-t border-surface-100" role="status" aria-live="polite">
      <div class="flex justify-between items-center text-xs font-semibold text-surface-700 mb-1.5">
        <span id="compression-phase-label">Preparing video engine…</span>
        <span id="compression-percentage-label">0%</span>
      </div>
      <div class="w-full bg-surface-200 rounded-full h-2.5 overflow-hidden">
        <div
          id="compression-progress-bar"
          class="bg-brand-600 h-2.5 rounded-full transition-all duration-200 ease-out"
          style="width: 0%;"
        ></div>
      </div>
      <p id="compression-subtext" class="text-[11px] text-surface-500 mt-1.5">Processing entirely on your CPU with WebAssembly. No files uploaded.</p>
    </div>

    <!-- Error Banner (Hidden until failure) -->
    <div id="compression-error-banner" class="hidden mt-4 p-3.5 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs flex items-start gap-2.5">
      <svg class="w-4 h-4 text-rose-600 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
      </svg>
      <div>
        <span class="font-bold">Compression Failed:</span>
        <span id="compression-error-text">An error occurred during video processing.</span>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="mt-6 pt-4 border-t border-surface-100 flex flex-wrap items-center justify-end gap-3">
      <button
        id="cancel-compress-btn"
        type="button"
        class="hidden px-4 py-2.5 text-xs font-semibold rounded-xl border border-surface-300 text-surface-700 hover:bg-surface-50 transition-colors"
      >
        Cancel
      </button>

      <button
        id="start-compress-btn"
        type="button"
        class="px-6 py-2.5 text-xs font-bold text-white bg-brand-600 hover:bg-brand-700 active:bg-brand-800 rounded-xl shadow-xs transition-colors focus-visible:outline-brand-500 flex items-center gap-2"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3" />
        </svg>
        <span>Compress Video</span>
      </button>
    </div>
  </div>

  <!-- 3. Results Section (Hidden until complete) -->
  <div id="video-result-card" class="hidden mt-6 rounded-2xl bg-white border border-surface-200/80 p-5 sm:p-6 shadow-xs">
    <div class="flex items-center gap-2 pb-4 border-b border-surface-100">
      <span class="p-1 rounded-full bg-emerald-100 text-emerald-700">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
        </svg>
      </span>
      <h3 class="text-sm font-bold text-surface-900">Compression Complete</h3>
      <span id="result-passes-badge" class="ml-auto text-[10px] font-mono font-semibold px-2 py-0.5 rounded-full bg-surface-100 text-surface-600">1 pass</span>
    </div>

    <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-4 items-center">
      <!-- Output Video Preview Player -->
      <div class="rounded-xl overflow-hidden bg-black/90 aspect-video flex items-center justify-center shadow-inner">
        <video
          id="result-video-preview"
          controls
          preload="metadata"
          playsinline
          class="w-full h-full object-contain max-h-48"
        ></video>
      </div>

      <!-- Result statistics -->
      <div class="space-y-2.5 text-xs">
        <div class="p-3 rounded-xl bg-emerald-50/70 border border-emerald-200/80 flex items-center justify-between">
          <div>
            <span class="text-emerald-800 font-bold block">Compressed Result</span>
            <span id="result-size-text" class="text-[11px] text-emerald-700">Original → Compressed</span>
          </div>
          <span id="result-reduction-badge" class="px-2.5 py-1 rounded-lg bg-emerald-600 text-white font-bold text-xs font-mono">
            -0%
          </span>
        </div>

        <div class="grid grid-cols-2 gap-2 text-[11px]">
          <div class="p-2 rounded-lg bg-surface-50 border border-surface-200/60">
            <span class="text-surface-500 block">Requested Target:</span>
            <span id="result-target-val" class="font-bold text-surface-800 font-mono">25 MB</span>
          </div>
          <div class="p-2 rounded-lg bg-surface-50 border border-surface-200/60">
            <span class="text-surface-500 block">Actual Output:</span>
            <span id="result-actual-val" class="font-bold text-surface-800 font-mono">-- MB</span>
          </div>
        </div>

        <div class="p-2 rounded-lg bg-surface-50 border border-surface-200/60 flex justify-between items-center text-[11px]">
          <span class="text-surface-500">Output Specs:</span>
          <span id="result-specs-val" class="font-semibold text-surface-800 font-mono">MP4 (H.264 / AAC)</span>
        </div>
      </div>
    </div>

    <!-- Actions: Download & Compress another -->
    <div class="mt-6 pt-4 border-t border-surface-100 flex flex-wrap items-center justify-between gap-3">
      <button
        id="compress-another-btn"
        type="button"
        class="text-xs font-semibold text-surface-600 hover:text-surface-900 transition-colors"
      >
        ← Compress Another Video
      </button>

      <a
        id="download-video-btn"
        href="#"
        download="compressed-video.mp4"
        class="px-5 py-2.5 text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 rounded-xl shadow-xs transition-colors focus-visible:outline-emerald-500 flex items-center gap-2"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
        </svg>
        <span>Download Compressed MP4</span>
      </a>
    </div>
  </div>
</div>

<script>
  import {
    extractVideoMetadata,
    calculateBudget,
    compressVideo,
    type VideoMetadata,
    type CompressionProgress,
  } from '../../scripts/video-compressor';

  console.log('[VideoCompressorTool] script module loaded and running!');

  // DOM elements
  const configCard = document.getElementById('video-config-card') as HTMLElement;
  const resultCard = document.getElementById('video-result-card') as HTMLElement;

  const videoFilename = document.getElementById('video-filename') as HTMLElement;
  const videoClearBtn = document.getElementById('video-clear-btn') as HTMLButtonElement;
  const sourcePreview = document.getElementById('source-video-preview') as HTMLVideoElement;
  const previewFallback = document.getElementById('video-preview-fallback') as HTMLElement;

  const metaFileSize = document.getElementById('meta-file-size') as HTMLElement;
  const metaDuration = document.getElementById('meta-duration') as HTMLElement;
  const metaResolution = document.getElementById('meta-resolution') as HTMLElement;
  const metaFormat = document.getElementById('meta-format') as HTMLElement;

  const targetSizeInput = document.getElementById('target-size-input') as HTMLInputElement;
  const presetBtns = document.querySelectorAll<HTMLButtonElement>('.preset-btn');
  const resolutionSelect = document.getElementById('resolution-select') as HTMLSelectElement;

  const calculatedBitrateDisplay = document.getElementById('calculated-bitrate-display') as HTMLElement;
  const targetWarningBanner = document.getElementById('target-warning-banner') as HTMLElement;
  const targetWarningText = document.getElementById('target-warning-text') as HTMLElement;
  const largeFileNotice = document.getElementById('large-file-notice') as HTMLElement;

  const progressContainer = document.getElementById('compression-progress-container') as HTMLElement;
  const phaseLabel = document.getElementById('compression-phase-label') as HTMLElement;
  const percentageLabel = document.getElementById('compression-percentage-label') as HTMLElement;
  const progressBar = document.getElementById('compression-progress-bar') as HTMLElement;

  const errorBanner = document.getElementById('compression-error-banner') as HTMLElement;
  const errorText = document.getElementById('compression-error-text') as HTMLElement;

  const startCompressBtn = document.getElementById('start-compress-btn') as HTMLButtonElement;
  const cancelCompressBtn = document.getElementById('cancel-compress-btn') as HTMLButtonElement;

  const resultPreview = document.getElementById('result-video-preview') as HTMLVideoElement;
  const resultPassesBadge = document.getElementById('result-passes-badge') as HTMLElement;
  const resultSizeText = document.getElementById('result-size-text') as HTMLElement;
  const resultReductionBadge = document.getElementById('result-reduction-badge') as HTMLElement;
  const resultTargetVal = document.getElementById('result-target-val') as HTMLElement;
  const resultActualVal = document.getElementById('result-actual-val') as HTMLElement;
  const resultSpecsVal = document.getElementById('result-specs-val') as HTMLElement;
  const downloadVideoBtn = document.getElementById('download-video-btn') as HTMLAnchorElement;
  const compressAnotherBtn = document.getElementById('compress-another-btn') as HTMLButtonElement;

  // Active state
  let currentFile: File | null = null;
  let currentMetadata: VideoMetadata | null = null;
  let activeSourceBlobUrl: string | null = null;
  let activeResultBlobUrl: string | null = null;
  let abortController: AbortController | null = null;
  let isCompressing = false;

  function formatBytes(bytes: number): string {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
  }

  function formatDuration(seconds: number): string {
    if (!seconds || seconds <= 0) return 'Unknown';
    const m = Math.floor(seconds / 60);
    const s = Math.floor(seconds % 60);
    return `${m}:${s < 10 ? '0' : ''}${s}`;
  }

  function updateBudgetUI(): void {
    if (!currentFile) return;

    const targetMB = parseFloat(targetSizeInput.value) || 25;
    const resPref = resolutionSelect.value as 'original' | '1080p' | '720p' | '480p';

    const duration = currentMetadata?.duration || 0;
    const width = currentMetadata?.width || 0;
    const height = currentMetadata?.height || 0;

    const budget = calculateBudget(duration, targetMB, width, height, currentFile.size, resPref);

    calculatedBitrateDisplay.textContent = `~${budget.videoBitrateKbps.toLocaleString()} kbps video (${budget.audioBitrateKbps} kbps audio)`;

    if (budget.warning) {
      targetWarningText.textContent = budget.warning;
      targetWarningBanner.classList.remove('hidden');
    } else {
      targetWarningBanner.classList.add('hidden');
    }

    if (currentFile.size > 100 * 1024 * 1024) {
      largeFileNotice.classList.remove('hidden');
    } else {
      largeFileNotice.classList.add('hidden');
    }
  }

  async function handleFileSelected(file: File): Promise<void> {
    console.log('[VideoCompressorTool] handleFileSelected called with:', file?.name);
    currentFile = file;
    errorBanner.classList.add('hidden');

    if (activeSourceBlobUrl) {
      URL.revokeObjectURL(activeSourceBlobUrl);
      activeSourceBlobUrl = null;
    }

    videoFilename.textContent = file.name;
    metaFileSize.textContent = formatBytes(file.size);

    const ext = file.name.split('.').pop()?.toUpperCase() || 'MP4';
    metaFormat.textContent = ext;

    // Show config card, hide result
    configCard.classList.remove('hidden');
    resultCard.classList.add('hidden');

    // Create local object URL for preview
    activeSourceBlobUrl = URL.createObjectURL(file);
    sourcePreview.src = activeSourceBlobUrl;
    previewFallback.classList.add('hidden');

    sourcePreview.onerror = () => {
      // If browser can't play MOV, show fallback badge
      previewFallback.classList.remove('hidden');
    };

    // Extract metadata
    currentMetadata = await extractVideoMetadata(file);

    metaDuration.textContent = formatDuration(currentMetadata.duration);
    if (currentMetadata.width > 0 && currentMetadata.height > 0) {
      metaResolution.textContent = `${currentMetadata.width} × ${currentMetadata.height}`;
    } else {
      metaResolution.textContent = 'Detected on decode';
    }

    // Default target: 60% of source for small files, or sensible MB range for larger files
    const suggestedTarget = file.size > 5 * 1024 * 1024
      ? Math.max(5, Math.min(25, Math.round((file.size / (1024 * 1024)) * 0.6)))
      : Math.max(0.1, Number(((file.size / (1024 * 1024)) * 0.6).toFixed(2)));
    targetSizeInput.value = suggestedTarget.toString();

    updateBudgetUI();
    configCard.setAttribute('data-ready', 'true');
  }

  function resetToIdle(): void {
    if (isCompressing && abortController) {
      abortController.abort();
    }
    isCompressing = false;
    currentFile = null;
    currentMetadata = null;

    if (activeSourceBlobUrl) {
      URL.revokeObjectURL(activeSourceBlobUrl);
      activeSourceBlobUrl = null;
    }
    if (activeResultBlobUrl) {
      URL.revokeObjectURL(activeResultBlobUrl);
      activeResultBlobUrl = null;
    }

    sourcePreview.src = '';
    resultPreview.src = '';

    videoFilename.textContent = 'video.mp4';
    metaDuration.textContent = 'Unknown';
    metaFileSize.textContent = '0 MB';
    metaResolution.textContent = 'Auto';

    configCard.removeAttribute('data-ready');
    configCard.classList.add('hidden');
    resultCard.classList.add('hidden');
    progressContainer.classList.add('hidden');
    errorBanner.classList.add('hidden');
    cancelCompressBtn.classList.add('hidden');
    startCompressBtn.disabled = false;
    startCompressBtn.classList.remove('opacity-50', 'cursor-not-allowed');

    document.dispatchEvent(new CustomEvent('file-dropzone:reset'));
  }

  const root = document.getElementById('video-compressor-root') as HTMLElement;

  function onFilesSelected(e: Event) {
    console.log('[VideoCompressorTool] Event file-dropzone:files-selected caught!');
    const customEvent = e as CustomEvent<{ files: File[] }>;
    const files = customEvent.detail?.files;
    console.log('[VideoCompressorTool] files in detail:', files?.length);
    if (files && files.length > 0) {
      handleFileSelected(files[0]);
    }
  }

  // Listen for dropzone file selection on both root and document
  root?.addEventListener('file-dropzone:files-selected', onFilesSelected);
  document.addEventListener('file-dropzone:files-selected', onFilesSelected);

  videoClearBtn?.addEventListener('click', resetToIdle);
  compressAnotherBtn?.addEventListener('click', resetToIdle);

  targetSizeInput?.addEventListener('input', updateBudgetUI);
  targetSizeInput?.addEventListener('change', updateBudgetUI);
  resolutionSelect?.addEventListener('change', updateBudgetUI);

  presetBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const val = btn.getAttribute('data-target');
      if (val) {
        targetSizeInput.value = val;
        presetBtns.forEach((b) => {
          b.classList.remove('bg-brand-50', 'text-brand-700', 'border-brand-200');
          b.classList.add('bg-surface-100', 'text-surface-700');
        });
        btn.classList.remove('bg-surface-100', 'text-surface-700');
        btn.classList.add('bg-brand-50', 'text-brand-700', 'border', 'border-brand-200');
        updateBudgetUI();
      }
    });
  });

  cancelCompressBtn?.addEventListener('click', () => {
    if (abortController) {
      abortController.abort();
      abortController = null;
    }
  });

  startCompressBtn?.addEventListener('click', async () => {
    if (!currentFile || isCompressing) return;

    isCompressing = true;
    abortController = new AbortController();

    // UI state
    startCompressBtn.disabled = true;
    startCompressBtn.classList.add('opacity-50', 'cursor-not-allowed');
    cancelCompressBtn.classList.remove('hidden');
    progressContainer.classList.remove('hidden');
    errorBanner.classList.add('hidden');
    progressBar.style.width = '5%';
    phaseLabel.textContent = 'Preparing video engine…';
    percentageLabel.textContent = '5%';

    const targetMB = Math.max(0.05, parseFloat(targetSizeInput.value) || 25);
    const resPref = resolutionSelect.value as 'original' | '1080p' | '720p' | '480p';

    try {
      const result = await compressVideo(
        currentFile,
        targetMB,
        resPref,
        (progress: CompressionProgress) => {
          phaseLabel.textContent = progress.message;
          percentageLabel.textContent = `${progress.percentage}%`;
          progressBar.style.width = `${progress.percentage}%`;
        },
        abortController.signal
      );

      // Succeeded: Display result card
      configCard.classList.add('hidden');
      resultCard.classList.remove('hidden');

      if (activeResultBlobUrl) {
        URL.revokeObjectURL(activeResultBlobUrl);
      }
      activeResultBlobUrl = URL.createObjectURL(result.blob);
      resultPreview.src = activeResultBlobUrl;

      resultSizeText.textContent = `${formatBytes(result.originalSize)} → ${formatBytes(result.compressedSize)}`;
      resultReductionBadge.textContent = `${result.ratio}% smaller`;
      resultTargetVal.textContent = `${(result.targetSize / (1024 * 1024)).toFixed(1)} MB`;
      resultActualVal.textContent = formatBytes(result.compressedSize);
      resultSpecsVal.textContent = `${result.width} × ${result.height} (MP4 / H.264 / AAC)`;
      resultPassesBadge.textContent = `${result.passes} pass${result.passes > 1 ? 'es (corrective)' : ''}`;

      downloadVideoBtn.href = activeResultBlobUrl;
      downloadVideoBtn.download = result.outputName;
    } catch (err: any) {
      if (err.name === 'AbortError') {
        errorText.textContent = 'Compression was cancelled.';
      } else {
        errorText.textContent = err.message || 'An unexpected error occurred during compression.';
      }
      errorBanner.classList.remove('hidden');
    } finally {
      isCompressing = false;
      abortController = null;
      startCompressBtn.disabled = false;
      startCompressBtn.classList.remove('opacity-50', 'cursor-not-allowed');
      cancelCompressBtn.classList.add('hidden');
      progressContainer.classList.add('hidden');
    }
  });
</script>
