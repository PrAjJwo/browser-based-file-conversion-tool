---
import FileDropzone from '../FileDropzone.astro';
import type { Tool } from '../../data/tools';

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
---

<div id="image-compressor-root" class="w-full space-y-6">
  <!-- Interactive Dropzone -->
  <FileDropzone
    toolTitle={tool.title}
    acceptedFiles={tool.acceptedFiles}
    acceptedTypesLabel={tool.acceptedTypesLabel}
    sizeWarningMB={tool.sizeWarningMB}
    sizeCeilingNote={tool.sizeCeilingNote}
    status={tool.status}
    multiple={true}
    managedExternally={true}
  />

  <!-- Memory Warning Banner -->
  <div
    id="compressor-batch-warning"
    class="hidden p-4 rounded-2xl bg-amber-50 border border-amber-200 text-amber-900 text-xs flex items-start gap-3 transition-all"
    role="alert"
  >
    <svg class="w-5 h-5 text-amber-600 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
    </svg>
    <div>
      <p class="font-semibold text-amber-950">Large image batch detected</p>
      <p class="mt-0.5 leading-relaxed text-amber-800">
        You have selected over 50 MB of photos. Processing executes sequentially in device memory to ensure browser stability.
      </p>
    </div>
  </div>

  <!-- Active Workspace Section -->
  <div id="compressor-workspace-section" class="hidden space-y-6">
    <!-- Queue Header Bar -->
    <div class="flex flex-wrap items-center justify-between gap-3 p-4 rounded-2xl bg-surface-50 border border-surface-200/80">
      <div class="flex items-center gap-2 text-xs text-surface-700">
        <span class="font-bold text-surface-900 text-sm" id="queue-images-count">0</span>
        <span>Images Selected</span>
        <span class="text-surface-400" id="queue-images-total-size">• Total: 0 Bytes</span>
      </div>
      <div class="flex items-center gap-3">
        <!-- Natural cross-link to Image Resizer -->
        <a
          href="/image/image-resizer"
          class="text-xs font-semibold text-brand-600 hover:text-brand-700 hover:underline flex items-center gap-1"
        >
          <span>Need to change dimensions too? Resize your image</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
        <span class="text-surface-300">|</span>
        <button
          id="compressor-clear-all-btn"
          type="button"
          class="text-xs font-semibold text-surface-500 hover:text-rose-600 transition-colors focus-visible:outline-brand-500"
        >
          Clear All
        </button>
      </div>
    </div>

    <!-- Compression Configuration Card -->
    <div class="p-5 rounded-2xl bg-surface-50 border border-surface-200/80 space-y-5" id="compressor-config-card">
      <div class="flex items-center justify-between pb-3 border-b border-surface-200/60 flex-wrap gap-2">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-brand-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
          <span class="text-xs font-bold uppercase tracking-wider text-surface-700">Compression Settings</span>
        </div>

        <span class="text-[11px] text-surface-500 font-medium">100% In-Browser • Zero Server Uploads</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 text-xs">
        <!-- Quality Slider -->
        <div id="quality-control-block" class="space-y-2">
          <div class="flex items-center justify-between">
            <label for="compress-quality-slider" class="font-semibold text-surface-900 block">
              Compression Quality
            </label>
            <span id="quality-val-label" class="text-brand-600 font-bold text-sm">80%</span>
          </div>
          <input
            id="compress-quality-slider"
            type="range"
            min="10"
            max="100"
            value="80"
            class="w-full h-2 bg-surface-200 rounded-lg appearance-none cursor-pointer accent-brand-600"
            aria-label="Compression Quality Percentage"
          />
          <!-- Quick Presets -->
          <div class="flex items-center gap-1.5 flex-wrap pt-1">
            <button type="button" class="preset-btn px-2 py-1 rounded-md border border-surface-200 bg-white hover:bg-brand-50 text-surface-700 text-[11px] font-semibold transition-colors" data-quality="50">Low Size (50%)</button>
            <button type="button" class="preset-btn px-2 py-1 rounded-md border border-brand-500 bg-brand-50 text-brand-700 text-[11px] font-semibold transition-colors" data-quality="80">Balanced (80%)</button>
            <button type="button" class="preset-btn px-2 py-1 rounded-md border border-surface-200 bg-white hover:bg-brand-50 text-surface-700 text-[11px] font-semibold transition-colors" data-quality="90">High (90%)</button>
          </div>
        </div>

        <!-- Output Format -->
        <div class="space-y-2">
          <label for="compress-output-format" class="font-semibold text-surface-900 block">
            Output Format
          </label>
          <select
            id="compress-output-format"
            class="w-full px-3 py-2 rounded-xl bg-white border border-surface-200 text-surface-800 font-medium focus:border-brand-500 focus:outline-none transition-colors text-xs"
            aria-label="Compression Output Format"
          >
            <option value="original" selected>Same as source (Preserve format)</option>
            <option value="image/jpeg">JPG / JPEG (High compatibility)</option>
            <option value="image/webp">WebP (Best size savings)</option>
            <option value="image/png">PNG (Lossless compression)</option>
          </select>
          <p id="compress-format-hint" class="text-[11px] text-surface-500 leading-relaxed">
            JPG and WebP support lossy quality reduction. PNG re-encoding is lossless.
          </p>
        </div>

        <!-- Optional Max Dimension Cap -->
        <div class="space-y-2">
          <label for="compress-max-dim" class="font-semibold text-surface-900 block">
            Max Dimension (Optional)
          </label>
          <select
            id="compress-max-dim"
            class="w-full px-3 py-2 rounded-xl bg-white border border-surface-200 text-surface-800 font-medium focus:border-brand-500 focus:outline-none transition-colors text-xs"
            aria-label="Optional Max Dimension Limit"
          >
            <option value="0" selected>Keep original dimensions</option>
            <option value="1920">Cap at 1920px (Full HD)</option>
            <option value="1280">Cap at 1280px (Standard Web)</option>
            <option value="800">Cap at 800px (Mobile Web)</option>
          </select>
          <p class="text-[11px] text-surface-500 leading-relaxed">
            Preserves original pixel dimensions by default without downscaling.
          </p>
        </div>
      </div>
    </div>

    <!-- Selected Images Queue List -->
    <div class="space-y-3">
      <div class="flex items-center justify-between">
        <h2 class="text-xs font-bold uppercase tracking-wider text-surface-700">Images in Queue</h2>
        <span class="text-[11px] text-surface-500" id="queue-count-sub">0 images</span>
      </div>

      <div id="compressor-queue-items" class="space-y-2.5 max-h-[28rem] overflow-y-auto pr-1">
        <!-- Dynamically injected cards -->
      </div>
    </div>

    <!-- Action Bar & Real Progress -->
    <div class="space-y-4 pt-2">
      <!-- Progress Bar -->
      <div id="compressor-progress-container" class="hidden space-y-2 p-4 rounded-2xl bg-surface-50 border border-surface-200" role="status" aria-live="polite">
        <div class="flex items-center justify-between text-xs font-semibold text-surface-700">
          <span id="compressor-progress-phase">Compressing images...</span>
          <span id="compressor-progress-percentage" class="text-brand-600 font-bold">0%</span>
        </div>
        <div class="w-full h-2.5 bg-surface-200 rounded-full overflow-hidden">
          <div id="compressor-progress-bar" class="h-full bg-brand-600 transition-all duration-200 rounded-full" style="width: 0%"></div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center justify-between gap-3">
        <button
          id="compress-all-btn"
          type="button"
          class="px-6 py-3 rounded-xl bg-brand-600 hover:bg-brand-700 active:bg-brand-800 text-white font-semibold text-xs sm:text-sm shadow-sm transition-all flex items-center gap-2 focus-visible:outline-brand-500"
        >
          <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
          <span id="compress-btn-label">Compress Images</span>
        </button>

        <span id="compressor-status-msg" class="text-xs text-surface-500 font-medium" role="status" aria-live="polite">
          Ready to compress
        </span>
      </div>
    </div>

    <!-- Results Section -->
    <div id="compressor-results-section" class="hidden space-y-4 pt-4 border-t border-surface-200/80">
      <div class="flex items-center justify-between flex-wrap gap-2">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-emerald-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <h2 class="text-sm font-bold text-surface-900">Compressed Results</h2>
          <span id="results-count-badge" class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-[10px] font-bold">0 Completed</span>
        </div>

        <!-- Download All as ZIP Button -->
        <button
          id="download-zip-btn"
          type="button"
          class="hidden px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white font-semibold text-xs shadow-xs transition-all flex items-center gap-2 focus-visible:outline-emerald-500"
        >
          <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          Download All as ZIP
        </button>
      </div>

      <!-- Result Cards Container -->
      <div id="compressor-results-list" class="space-y-3">
        <!-- Dynamically injected result cards -->
      </div>
    </div>
  </div>
</div>

<script>
  import {
    inspectCompressorFile,
    compressImageItem,
    downloadCompressedBlob,
    createCompressedZip,
    generateItemId,
    formatBytes,
    type ImageCompressorItem,
    type CompressorConfig,
    type CompressionOutputFormat,
  } from '../../scripts/image-compressor';

  const root = document.getElementById('image-compressor-root');

  if (root) {
    const batchWarning = root.querySelector<HTMLElement>('#compressor-batch-warning')!;
    const workspaceSection = root.querySelector<HTMLElement>('#compressor-workspace-section')!;
    const queueImagesCount = root.querySelector<HTMLElement>('#queue-images-count')!;
    const queueImagesTotalSize = root.querySelector<HTMLElement>('#queue-images-total-size')!;
    const queueCountSub = root.querySelector<HTMLElement>('#queue-count-sub')!;
    const queueItemsContainer = root.querySelector<HTMLElement>('#compressor-queue-items')!;
    const clearAllBtn = root.querySelector<HTMLButtonElement>('#compressor-clear-all-btn')!;

    const qualityControlBlock = root.querySelector<HTMLElement>('#quality-control-block')!;
    const qualitySlider = root.querySelector<HTMLInputElement>('#compress-quality-slider')!;
    const qualityValLabel = root.querySelector<HTMLElement>('#quality-val-label')!;
    const presetButtons = root.querySelectorAll<HTMLButtonElement>('.preset-btn');
    const outputFormatSelect = root.querySelector<HTMLSelectElement>('#compress-output-format')!;
    const formatHint = root.querySelector<HTMLElement>('#compress-format-hint')!;
    const maxDimSelect = root.querySelector<HTMLSelectElement>('#compress-max-dim')!;

    const compressAllBtn = root.querySelector<HTMLButtonElement>('#compress-all-btn')!;
    const compressBtnLabel = root.querySelector<HTMLElement>('#compress-btn-label')!;
    const statusMsg = root.querySelector<HTMLElement>('#compressor-status-msg')!;

    const progressContainer = root.querySelector<HTMLElement>('#compressor-progress-container')!;
    const progressPhase = root.querySelector<HTMLElement>('#compressor-progress-phase')!;
    const progressPercentage = root.querySelector<HTMLElement>('#compressor-progress-percentage')!;
    const progressBar = root.querySelector<HTMLElement>('#compressor-progress-bar')!;

    const resultsSection = root.querySelector<HTMLElement>('#compressor-results-section')!;
    const resultsCountBadge = root.querySelector<HTMLElement>('#results-count-badge')!;
    const downloadZipBtn = root.querySelector<HTMLButtonElement>('#download-zip-btn')!;
    const resultsList = root.querySelector<HTMLElement>('#compressor-results-list')!;

    // State
    let items: ImageCompressorItem[] = [];
    let isProcessing = false;

    function getConfig(): CompressorConfig {
      const q = parseInt(qualitySlider.value, 10) / 100;
      const fmt = outputFormatSelect.value as CompressionOutputFormat;
      const maxDim = parseInt(maxDimSelect.value, 10) || 0;

      return {
        quality: q,
        outputFormat: fmt,
        maxDimension: maxDim > 0 ? maxDim : undefined,
      };
    }

    function updateFormatDisplay() {
      const fmt = outputFormatSelect.value;
      if (fmt === 'image/png') {
        qualityControlBlock.classList.add('opacity-40', 'pointer-events-none');
        formatHint.textContent = 'PNG uses lossless compression. Quality factor is not applicable to Canvas PNG export.';
      } else {
        qualityControlBlock.classList.remove('opacity-40', 'pointer-events-none');
        if (fmt === 'image/jpeg') {
          formatHint.textContent = 'JPEG provides high compression. Transparent areas are composited onto clean white.';
        } else if (fmt === 'image/webp') {
          formatHint.textContent = 'WebP provides superior lossy compression and preserves alpha transparency.';
        } else {
          formatHint.textContent = 'Original format preserved. Lossy images (JPG, WebP) scale with the quality slider.';
        }
      }
    }

    async function handleAddedFiles(fileList: File[]) {
      const newItems: ImageCompressorItem[] = [];

      for (const file of fileList) {
        const id = generateItemId();
        try {
          const inspected = await inspectCompressorFile(file);
          newItems.push({
            id,
            file,
            filename: file.name,
            originalWidth: inspected.width,
            originalHeight: inspected.height,
            originalSizeBytes: file.size,
            originalMime: inspected.mime,
            thumbnailUrl: inspected.thumbnailUrl,
            status: 'ready',
          });
        } catch (err: any) {
          // File error isolation
          newItems.push({
            id,
            file,
            filename: file.name,
            originalWidth: 0,
            originalHeight: 0,
            originalSizeBytes: file.size,
            originalMime: '',
            thumbnailUrl: '',
            status: 'failed',
            errorMessage: err?.message || 'Unsupported or corrupted image file.',
          });
        }
      }

      items = [...items, ...newItems];
      updateWorkspace();
    }

    function updateWorkspace() {
      if (items.length === 0) {
        workspaceSection.classList.add('hidden');
        batchWarning.classList.add('hidden');
        return;
      }

      workspaceSection.classList.remove('hidden');

      const totalBytes = items.reduce((acc, i) => acc + i.originalSizeBytes, 0);
      const totalMB = totalBytes / (1024 * 1024);

      queueImagesCount.textContent = String(items.length);
      queueImagesTotalSize.textContent = `• Total: ${formatBytes(totalBytes)}`;
      queueCountSub.textContent = `${items.length} image${items.length === 1 ? '' : 's'}`;
      compressBtnLabel.textContent = `Compress ${items.length} Image${items.length === 1 ? '' : 's'}`;

      if (totalMB > 50) {
        batchWarning.classList.remove('hidden');
      } else {
        batchWarning.classList.add('hidden');
      }

      renderQueue();
    }

    function renderQueue() {
      queueItemsContainer.innerHTML = '';

      items.forEach((item, index) => {
        const card = document.createElement('div');
        card.className = 'flex items-center justify-between gap-3 p-3 sm:p-4 rounded-xl bg-white border border-surface-200 shadow-xs transition-all';
        card.setAttribute('data-id', item.id);

        let statusBadge = '';
        if (item.status === 'completed') {
          statusBadge = '<span class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-[10px] font-bold">Completed</span>';
        } else if (item.status === 'compressing') {
          statusBadge = '<span class="px-2 py-0.5 rounded-full bg-brand-100 text-brand-800 text-[10px] font-bold animate-pulse">Compressing...</span>';
        } else if (item.status === 'failed') {
          statusBadge = `<span class="px-2 py-0.5 rounded-full bg-rose-100 text-rose-800 text-[10px] font-bold" title="${item.errorMessage || 'Failed'}">Failed</span>`;
        } else {
          statusBadge = '<span class="px-2 py-0.5 rounded-full bg-surface-100 text-surface-700 text-[10px] font-semibold">Ready</span>';
        }

        card.innerHTML = `
          <div class="flex items-center gap-3 min-w-0">
            <div class="w-12 h-12 rounded-lg bg-surface-100 border border-surface-200 overflow-hidden flex items-center justify-center flex-shrink-0">
              ${
                item.thumbnailUrl
                  ? `<img src="${item.thumbnailUrl}" alt="${item.filename}" class="w-full h-full object-cover" />`
                  : `<svg class="w-6 h-6 text-surface-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>`
              }
            </div>
            <div class="min-w-0">
              <p class="text-xs sm:text-sm font-semibold text-surface-900 truncate">${item.filename}</p>
              <div class="flex items-center gap-2 text-[11px] text-surface-500 mt-0.5 flex-wrap">
                ${
                  item.status === 'failed'
                    ? `<span class="text-rose-600 font-medium">${item.errorMessage || 'Invalid Image'}</span>`
                    : `<span>${item.originalWidth} × ${item.originalHeight} px</span>
                       <span>• ${formatBytes(item.originalSizeBytes)}</span>
                       <span class="uppercase text-[10px] font-bold px-1.5 py-0.2 rounded bg-surface-200/70 text-surface-600">${item.originalMime.replace('image/', '')}</span>`
                }
              </div>
            </div>
          </div>

          <div class="flex items-center gap-2 flex-shrink-0">
            ${statusBadge}
            <button
              type="button"
              class="remove-item-btn p-1.5 rounded-lg text-surface-400 hover:text-rose-600 hover:bg-rose-50 transition-colors focus-visible:outline-brand-500"
              data-index="${index}"
              aria-label="Remove ${item.filename}"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>
        `;

        const removeBtn = card.querySelector<HTMLButtonElement>('.remove-item-btn')!;
        removeBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          removeItem(index);
        });

        queueItemsContainer.appendChild(card);
      });
    }

    function removeItem(index: number) {
      const removed = items.splice(index, 1)[0];
      if (removed && removed.thumbnailUrl) {
        URL.revokeObjectURL(removed.thumbnailUrl);
      }
      if (removed && removed.resultUrl) {
        URL.revokeObjectURL(removed.resultUrl);
      }
      updateWorkspace();
    }

    function clearAll() {
      items.forEach((i) => {
        if (i.thumbnailUrl) URL.revokeObjectURL(i.thumbnailUrl);
        if (i.resultUrl) URL.revokeObjectURL(i.resultUrl);
      });
      items = [];
      resultsSection.classList.add('hidden');
      resultsList.innerHTML = '';
      progressContainer.classList.add('hidden');
      updateWorkspace();
    }

    async function processBatch() {
      if (isProcessing || items.length === 0) return;
      isProcessing = true;
      compressAllBtn.disabled = true;
      compressAllBtn.classList.add('opacity-50', 'cursor-not-allowed');

      progressContainer.classList.remove('hidden');
      statusMsg.textContent = 'Processing compression batch...';
      statusMsg.className = 'text-xs text-brand-600 font-semibold';

      const config = getConfig();
      const existingNames = new Set<string>();

      let completedCount = 0;
      let failedCount = 0;

      for (let i = 0; i < items.length; i++) {
        const item = items[i];

        if (item.status === 'failed') {
          failedCount++;
          continue;
        }

        item.status = 'compressing';
        renderQueue();

        const progressPct = Math.round(((i + 1) / items.length) * 100);
        progressPhase.textContent = `Compressing file ${i + 1} of ${items.length}: ${item.filename}`;
        progressPercentage.textContent = `${progressPct}%`;
        progressBar.style.width = `${progressPct}%`;

        try {
          const result = await compressImageItem(item, config, existingNames);
          item.status = 'completed';
          item.resultBlob = result.blob;
          item.resultUrl = URL.createObjectURL(result.blob);
          item.resultWidth = result.width;
          item.resultHeight = result.height;
          item.resultSizeBytes = result.blob.size;
          item.resultFilename = result.filename;
          item.resultMime = result.mimeType;
          item.isLarger = result.isLarger;
          completedCount++;
        } catch (err: any) {
          item.status = 'failed';
          item.errorMessage = err?.message || 'Compression failed.';
          failedCount++;
        }

        renderQueue();
      }

      isProcessing = false;
      compressAllBtn.disabled = false;
      compressAllBtn.classList.remove('opacity-50', 'cursor-not-allowed');

      progressPhase.textContent = `Batch finished (${completedCount} compressed${failedCount > 0 ? `, ${failedCount} failed` : ''})`;
      statusMsg.textContent = `Completed ${completedCount} of ${items.length} images`;
      statusMsg.className = 'text-xs text-emerald-600 font-semibold';

      renderResults();
    }

    function renderResults() {
      const successful = items.filter((i) => i.status === 'completed' && i.resultBlob);
      if (successful.length === 0) {
        resultsSection.classList.add('hidden');
        return;
      }

      resultsSection.classList.remove('hidden');
      resultsCountBadge.textContent = `${successful.length} Completed`;

      if (successful.length >= 2) {
        downloadZipBtn.classList.remove('hidden');
      } else {
        downloadZipBtn.classList.add('hidden');
      }

      resultsList.innerHTML = '';

      successful.forEach((item) => {
        const card = document.createElement('div');
        card.className = 'p-4 rounded-xl bg-white border border-surface-200/90 shadow-xs flex flex-wrap items-center justify-between gap-4';

        const sizeDiff = item.resultSizeBytes! - item.originalSizeBytes;
        const diffPct = Math.round((Math.abs(sizeDiff) / item.originalSizeBytes) * 100);

        let diffText = '';
        if (sizeDiff < 0) {
          diffText = `<span class="text-emerald-700 font-bold">${formatBytes(item.originalSizeBytes)} → ${formatBytes(item.resultSizeBytes!)} (${diffPct}% smaller)</span>`;
        } else if (sizeDiff > 0) {
          diffText = `<span class="text-amber-700 font-semibold">${formatBytes(item.originalSizeBytes)} → ${formatBytes(item.resultSizeBytes!)} (+${diffPct}% larger)</span>`;
        } else {
          diffText = `<span class="text-surface-600 font-medium">${formatBytes(item.originalSizeBytes)} (No size change)</span>`;
        }

        card.innerHTML = `
          <div class="flex items-center gap-3.5 min-w-0">
            <div class="w-14 h-14 rounded-lg bg-surface-100 border border-surface-200 overflow-hidden flex items-center justify-center flex-shrink-0">
              <img src="${item.resultUrl}" alt="${item.resultFilename}" class="w-full h-full object-cover" />
            </div>
            <div class="min-w-0">
              <p class="font-bold text-xs sm:text-sm text-surface-900 truncate">${item.resultFilename}</p>
              <div class="text-[11px] text-surface-500 mt-0.5 space-y-0.5">
                <p>${diffText}</p>
                <p>
                  <span>${item.resultWidth} × ${item.resultHeight} px</span>
                  <span class="text-surface-400">•</span>
                  <span class="uppercase font-semibold">${item.resultMime?.replace('image/', '')}</span>
                </p>
              </div>
            </div>
          </div>

          <button
            type="button"
            class="download-single-btn px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white font-semibold text-xs shadow-xs transition-all flex items-center gap-1.5 focus-visible:outline-emerald-500"
          >
            <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            Download Image
          </button>
        `;

        const dlBtn = card.querySelector<HTMLButtonElement>('.download-single-btn')!;
        dlBtn.addEventListener('click', () => {
          if (item.resultBlob && item.resultFilename) {
            downloadCompressedBlob(item.resultBlob, item.resultFilename);
          }
        });

        resultsList.appendChild(card);
      });

      resultsSection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    async function downloadAllZip() {
      const successful = items.filter((i) => i.status === 'completed' && i.resultBlob);
      if (successful.length === 0) return;

      downloadZipBtn.disabled = true;
      downloadZipBtn.classList.add('opacity-50');
      statusMsg.textContent = 'Generating ZIP archive...';

      try {
        const zipBlob = await createCompressedZip(successful);
        downloadCompressedBlob(zipBlob, 'compressed-images.zip');
        statusMsg.textContent = 'Downloaded compressed-images.zip';
        statusMsg.className = 'text-xs text-emerald-600 font-semibold';
      } catch (err: any) {
        statusMsg.textContent = `ZIP generation failed: ${err?.message || 'Unknown error'}`;
        statusMsg.className = 'text-xs text-rose-600 font-semibold';
      } finally {
        downloadZipBtn.disabled = false;
        downloadZipBtn.classList.remove('opacity-50');
      }
    }

    // Event Listeners
    document.addEventListener('file-dropzone:files-selected', ((e: Event) => {
      const customEvent = e as CustomEvent<{ files: File[] }>;
      if (customEvent.detail.files && customEvent.detail.files.length > 0) {
        handleAddedFiles(customEvent.detail.files);
      }
    }) as EventListener);

    qualitySlider.addEventListener('input', () => {
      const q = parseInt(qualitySlider.value, 10);
      qualityValLabel.textContent = `${q}%`;
      presetButtons.forEach((btn) => {
        const bQ = parseInt(btn.getAttribute('data-quality') || '0', 10);
        if (bQ === q) {
          btn.className = 'preset-btn px-2 py-1 rounded-md border border-brand-500 bg-brand-50 text-brand-700 text-[11px] font-semibold transition-colors';
        } else {
          btn.className = 'preset-btn px-2 py-1 rounded-md border border-surface-200 bg-white hover:bg-brand-50 text-surface-700 text-[11px] font-semibold transition-colors';
        }
      });
    });

    presetButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const q = btn.getAttribute('data-quality');
        if (q) {
          qualitySlider.value = q;
          qualitySlider.dispatchEvent(new Event('input'));
        }
      });
    });

    outputFormatSelect.addEventListener('change', updateFormatDisplay);
    clearAllBtn.addEventListener('click', clearAll);
    compressAllBtn.addEventListener('click', processBatch);
    downloadZipBtn.addEventListener('click', downloadAllZip);
  }
</script>
