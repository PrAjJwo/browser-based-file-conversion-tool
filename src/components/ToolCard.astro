---
import type { Tool } from '../data/tools';

interface Props {
  tool: Tool;
  class?: string;
}

const { tool, class: className = '' } = Astro.props;

// Category badge color accents
const categoryStyles: Record<string, { bg: string; text: string; border: string; iconBg: string; iconText: string }> = {
  image: {
    bg: 'bg-blue-50',
    text: 'text-blue-700',
    border: 'border-blue-200/70',
    iconBg: 'bg-blue-50 text-blue-600 group-hover:bg-blue-600 group-hover:text-white',
    iconText: 'text-blue-600',
  },
  video: {
    bg: 'bg-violet-50',
    text: 'text-violet-700',
    border: 'border-violet-200/70',
    iconBg: 'bg-violet-50 text-violet-600 group-hover:bg-violet-600 group-hover:text-white',
    iconText: 'text-violet-600',
  },
  pdf: {
    bg: 'bg-rose-50',
    text: 'text-rose-700',
    border: 'border-rose-200/70',
    iconBg: 'bg-rose-50 text-rose-600 group-hover:bg-rose-600 group-hover:text-white',
    iconText: 'text-rose-600',
  },
  audio: {
    bg: 'bg-amber-50',
    text: 'text-amber-700',
    border: 'border-amber-200/70',
    iconBg: 'bg-amber-50 text-amber-600 group-hover:bg-amber-600 group-hover:text-white',
    iconText: 'text-amber-600',
  },
};

const catStyle = categoryStyles[tool.category] || categoryStyles.image;
---

<a
  href={`/${tool.category}/${tool.slug}`}
  class={`tool-grid-card group block p-5 rounded-2xl bg-white border border-surface-200/80 shadow-2xs hover:shadow-md hover:border-brand-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 transition-all duration-200 relative overflow-hidden flex flex-col justify-between ${className}`}
  data-slug={tool.slug}
  data-category={tool.category}
  data-title={tool.title.toLowerCase()}
  data-blurb={tool.shortBlurb.toLowerCase()}
  data-keywords={`${tool.title} ${tool.shortBlurb} ${tool.acceptedFiles} ${tool.category} ${tool.group || ''}`.toLowerCase()}
>
  <div>
    <!-- Top Row: Distinct Icon & Category/Status Badges -->
    <div class="flex items-start justify-between gap-3 mb-3.5">
      <div class={`w-10 h-10 rounded-xl flex items-center justify-center font-bold transition-all duration-200 ${catStyle.iconBg}`}>
        {tool.slug === 'video-compressor' ? (
          <!-- Video Camera Icon -->
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
        ) : tool.slug === 'image-to-pdf' ? (
          <!-- Stacked Pages / PDF Icon -->
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
          </svg>
        ) : tool.slug === 'subtitle-converter' ? (
          <!-- Closed Captions / Subtitles Icon -->
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" />
          </svg>
        ) : tool.slug === 'image-resizer' ? (
          <!-- Expand / Resize Dimensions Icon -->
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
          </svg>
        ) : tool.slug === 'image-compressor' ? (
          <!-- Compress / Minimize File Size Icon -->
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
          </svg>
        ) : tool.slug === 'image-converter' ? (
          <!-- Format Exchange Arrows Icon -->
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
          </svg>
        ) : tool.slug === 'social-resizer' ? (
          <!-- Social Framing / Grid Icon -->
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
          </svg>
        ) : tool.slug === 'heic-to-jpg' || tool.slug === 'jpg-to-heic' ? (
          <!-- Photo / Camera Frame Icon -->
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        ) : (
          <!-- Fallback Document Icon -->
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        )}
      </div>

      <div class="flex items-center gap-1.5 flex-wrap justify-end">
        <span class={`text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-md border ${catStyle.bg} ${catStyle.text} ${catStyle.border}`}>
          {tool.category === 'pdf' ? (tool.slug === 'subtitle-converter' ? 'Subtitles' : 'PDF') : tool.category}
        </span>
        {tool.status === 'coming-soon' && (
          <span class="text-[10px] font-semibold text-amber-800 bg-amber-50 px-2 py-0.5 rounded-md border border-amber-200/60">
            Soon
          </span>
        )}
      </div>
    </div>

    <!-- Title & Purpose -->
    <h3 class="text-sm sm:text-base font-bold text-surface-900 group-hover:text-brand-600 transition-colors leading-snug">
      {tool.title}
    </h3>
    
    <p class="text-xs text-surface-500 mt-1 leading-relaxed line-clamp-2">
      {tool.shortBlurb}
    </p>
  </div>

  <!-- Bottom Details Bar -->
  <div class="mt-4 pt-3 border-t border-surface-100 flex items-center justify-between text-xs text-surface-400">
    <span class="truncate max-w-[170px] font-mono text-[10px] text-surface-500">
      {tool.acceptedTypesLabel}
    </span>
    <span class="text-brand-600 font-semibold group-hover:translate-x-0.5 transition-transform inline-flex items-center gap-0.5 text-xs">
      Open Tool &rarr;
    </span>
  </div>
</a>
