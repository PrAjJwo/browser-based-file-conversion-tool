---
import { getToolsByCategory } from '../data/tools';
import PrivacyBadge from './PrivacyBadge.astro';
import BrandLogo from './BrandLogo.astro';

const imageTools = getToolsByCategory('image');
const videoTools = getToolsByCategory('video');
const pdfTools = getToolsByCategory('pdf');

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 w-full border-b border-surface-200 bg-white/95 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 gap-4">
      <!-- 1. Brand Logo -->
      <div class="flex items-center gap-3 flex-shrink-0">
        <a href="/" class="group inline-flex items-center focus-visible:outline-brand-500 rounded-lg">
          <BrandLogo size="md" showWordmark={true} showTagline={true} />
        </a>
      </div>

      <!-- 2. Desktop Navigation with Direct Tool Dropdowns -->
      <nav class="hidden md:flex items-center gap-1.5" aria-label="Main Navigation">
        <!-- Image Tools Dropdown -->
        <div class="relative dropdown-group">
          <button
            type="button"
            class={`dropdown-trigger inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold tracking-wide transition-all ${
              currentPath.startsWith('/image')
                ? 'bg-brand-50 text-brand-700 font-bold'
                : 'text-surface-700 hover:text-surface-950 hover:bg-surface-100'
            }`}
            aria-expanded="false"
            aria-haspopup="true"
          >
            <span>Image Tools</span>
            <svg class="w-3.5 h-3.5 text-surface-400 transition-transform duration-150 chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <!-- Dropdown Mega-Panel -->
          <div class="dropdown-panel hidden absolute left-0 top-full pt-2 w-[480px] z-50">
            <div class="bg-white border border-surface-200/90 rounded-xl p-4 shadow-lg">
              <div class="grid grid-cols-2 gap-4">
                <!-- Group 1: Format Conversion -->
                <div>
                  <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-surface-500 block mb-2 px-2">
                    Format Conversion
                  </span>
                  <div class="space-y-1">
                    {imageTools.filter(t => t.group === 'Image Conversion').map((tool) => (
                      <a
                        href={`/image/${tool.slug}`}
                        class="block px-2.5 py-1.5 rounded-lg hover:bg-surface-100 transition-colors group"
                      >
                        <span class="text-xs font-semibold text-surface-900 group-hover:text-brand-600 block leading-tight">
                          {tool.title}
                        </span>
                        <span class="text-[11px] text-surface-500 block truncate mt-0.5">
                          {tool.acceptedTypesLabel}
                        </span>
                      </a>
                    ))}
                  </div>
                </div>

                <!-- Group 2: Resize & Compress -->
                <div>
                  <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-surface-500 block mb-2 px-2">
                    Resize &amp; Compress
                  </span>
                  <div class="space-y-1">
                    {imageTools.filter(t => t.group === 'Resize & Compress').map((tool) => (
                      <a
                        href={`/image/${tool.slug}`}
                        class="block px-2.5 py-1.5 rounded-lg hover:bg-surface-100 transition-colors group"
                      >
                        <span class="text-xs font-semibold text-surface-900 group-hover:text-brand-600 block leading-tight">
                          {tool.title}
                        </span>
                        <span class="text-[11px] text-surface-500 block truncate mt-0.5">
                          {tool.acceptedTypesLabel}
                        </span>
                      </a>
                    ))}
                  </div>
                </div>
              </div>

              <!-- Footer of Dropdown -->
              <div class="mt-3 pt-2.5 border-t border-surface-100 flex items-center justify-between px-2">
                <span class="text-[11px] text-surface-500 font-mono">6 active utilities</span>
                <a href="/image" class="text-xs font-semibold text-brand-600 hover:text-brand-700 inline-flex items-center gap-1">
                  View All Image Tools &rarr;
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Video Tools Dropdown -->
        <div class="relative dropdown-group">
          <button
            type="button"
            class={`dropdown-trigger inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold tracking-wide transition-all ${
              currentPath.startsWith('/video')
                ? 'bg-brand-50 text-brand-700 font-bold'
                : 'text-surface-700 hover:text-surface-950 hover:bg-surface-100'
            }`}
            aria-expanded="false"
            aria-haspopup="true"
          >
            <span>Video Tools</span>
            <svg class="w-3.5 h-3.5 text-surface-400 transition-transform duration-150 chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <div class="dropdown-panel hidden absolute left-0 top-full pt-2 w-72 z-50">
            <div class="bg-white border border-surface-200/90 rounded-xl p-3 shadow-lg">
              <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-surface-500 block mb-2 px-2">
                Video Compression
              </span>
              <div class="space-y-1">
                {videoTools.map((tool) => (
                  <a
                    href={`/video/${tool.slug}`}
                    class="block px-2.5 py-2 rounded-lg hover:bg-surface-100 transition-colors group"
                  >
                    <span class="text-xs font-semibold text-surface-900 group-hover:text-brand-600 block leading-tight">
                      {tool.title}
                    </span>
                    <span class="text-[11px] text-surface-500 block mt-0.5">
                      Shrink MP4/MOV under custom size limits
                    </span>
                  </a>
                ))}
              </div>

              <div class="mt-3 pt-2.5 border-t border-surface-100 px-2 flex justify-between items-center">
                <span class="text-[11px] text-surface-500 font-mono">1 active utility</span>
                <a href="/video" class="text-xs font-semibold text-brand-600 hover:text-brand-700 inline-flex items-center gap-1">
                  View Video Suite &rarr;
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- PDF & Documents Dropdown -->
        <div class="relative dropdown-group">
          <button
            type="button"
            class={`dropdown-trigger inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold tracking-wide transition-all ${
              currentPath.startsWith('/pdf')
                ? 'bg-brand-50 text-brand-700 font-bold'
                : 'text-surface-700 hover:text-surface-950 hover:bg-surface-100'
            }`}
            aria-expanded="false"
            aria-haspopup="true"
          >
            <span>PDF &amp; Documents</span>
            <svg class="w-3.5 h-3.5 text-surface-400 transition-transform duration-150 chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <div class="dropdown-panel hidden absolute left-0 top-full pt-2 w-80 z-50">
            <div class="bg-white border border-surface-200/90 rounded-xl p-3 shadow-lg">
              <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-surface-500 block mb-2 px-2">
                Documents &amp; Subtitles
              </span>
              <div class="space-y-1">
                {pdfTools.map((tool) => (
                  <a
                    href={`/pdf/${tool.slug}`}
                    class="block px-2.5 py-2 rounded-lg hover:bg-surface-100 transition-colors group"
                  >
                    <span class="text-xs font-semibold text-surface-900 group-hover:text-brand-600 block leading-tight">
                      {tool.title}
                    </span>
                    <span class="text-[11px] text-surface-500 block mt-0.5">
                      {tool.slug === 'image-to-pdf' ? 'Combine photos and scans into PDF' : 'Convert & edit SRT/VTT/TXT subtitles'}
                    </span>
                  </a>
                ))}
              </div>

              <div class="mt-3 pt-2.5 border-t border-surface-100 px-2 flex justify-between items-center">
                <span class="text-[11px] text-surface-500 font-mono">2 active utilities</span>
                <a href="/pdf" class="text-xs font-semibold text-brand-600 hover:text-brand-700 inline-flex items-center gap-1">
                  View PDF Suite &rarr;
                </a>
              </div>
            </div>
          </div>
        </div>
      </nav>

      <!-- 3. Header Right: Quick Tool Search & Trust Indicator -->
      <div class="flex items-center gap-3">
        <!-- Quick Search Pill -->
        <a
          href="/#tools-directory"
          class="hidden lg:inline-flex items-center gap-2 px-2.5 py-1.5 rounded-lg border border-surface-200 text-xs text-surface-500 hover:text-surface-900 hover:border-surface-300 transition select-none"
          title="Jump to instant tool search"
        >
          <svg class="w-3.5 h-3.5 text-surface-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
          </svg>
          <span>Find tool...</span>
          <kbd class="px-1.5 py-0.2 rounded bg-surface-100 border border-surface-200 text-[10px] font-mono font-semibold">/</kbd>
        </a>

        <!-- Header Trust Indicator -->
        <div class="hidden sm:block">
          <PrivacyBadge variant="header" />
        </div>

        <!-- Mobile Hamburger Button -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="md:hidden p-2 rounded-lg text-surface-600 hover:text-surface-900 hover:bg-surface-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
          aria-label="Open mobile navigation"
          aria-expanded="false"
          aria-controls="mobile-drawer"
        >
          <svg id="menu-icon-open" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
          <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

  <!-- 4. Mobile Slide-out Drawer Overlay -->
  <div
    id="mobile-drawer-backdrop"
    class="fixed inset-0 bg-surface-950/40 z-40 hidden md:hidden transition-opacity"
    aria-hidden="true"
  ></div>

  <!-- Mobile Drawer Container -->
  <div
    id="mobile-drawer"
    class="fixed inset-y-0 right-0 max-w-xs w-full bg-white z-50 shadow-2xl border-l border-surface-200 hidden md:hidden flex flex-col justify-between overflow-y-auto"
    role="dialog"
    aria-modal="true"
    aria-label="Mobile Navigation"
  >
    <!-- Drawer Header -->
    <div class="p-4 border-b border-surface-100 flex items-center justify-between">
      <BrandLogo size="sm" showWordmark={true} />
      <button
        id="mobile-drawer-close"
        type="button"
        class="p-1.5 rounded-lg text-surface-500 hover:text-surface-900 hover:bg-surface-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
        aria-label="Close navigation"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Drawer Navigation Content -->
    <div class="p-4 flex-1 space-y-5 overflow-y-auto">
      <!-- Search Shortcut -->
      <a
        href="/#tools-directory"
        class="flex items-center gap-2.5 px-3 py-2.5 rounded-xl bg-surface-50 border border-surface-200 text-xs font-medium text-surface-600 hover:text-surface-900 hover:border-brand-300 transition"
      >
        <svg class="w-4 h-4 text-surface-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
        </svg>
        <span>Search all active tools</span>
      </a>

      <!-- Category 1: Image Tools -->
      <div>
        <div class="flex items-center justify-between pb-1 mb-2 border-b border-surface-100">
          <a href="/image" class="text-xs font-bold text-surface-950 uppercase tracking-wider hover:text-brand-600">
            Image Tools ({imageTools.length})
          </a>
          <a href="/image" class="text-[11px] text-brand-600 font-semibold">View Suite &rarr;</a>
        </div>
        <div class="space-y-1 pl-1">
          {imageTools.map((t) => (
            <a
              href={`/image/${t.slug}`}
              class="block px-2.5 py-1.5 rounded-lg text-xs font-medium text-surface-700 hover:bg-surface-100 hover:text-surface-950 transition"
            >
              {t.title}
            </a>
          ))}
        </div>
      </div>

      <!-- Category 2: Video Tools -->
      <div>
        <div class="flex items-center justify-between pb-1 mb-2 border-b border-surface-100">
          <a href="/video" class="text-xs font-bold text-surface-950 uppercase tracking-wider hover:text-brand-600">
            Video Tools ({videoTools.length})
          </a>
          <a href="/video" class="text-[11px] text-brand-600 font-semibold">View Suite &rarr;</a>
        </div>
        <div class="space-y-1 pl-1">
          {videoTools.map((t) => (
            <a
              href={`/video/${t.slug}`}
              class="block px-2.5 py-1.5 rounded-lg text-xs font-medium text-surface-700 hover:bg-surface-100 hover:text-surface-950 transition"
            >
              {t.title}
            </a>
          ))}
        </div>
      </div>

      <!-- Category 3: PDF & Documents -->
      <div>
        <div class="flex items-center justify-between pb-1 mb-2 border-b border-surface-100">
          <a href="/pdf" class="text-xs font-bold text-surface-950 uppercase tracking-wider hover:text-brand-600">
            PDF &amp; Documents ({pdfTools.length})
          </a>
          <a href="/pdf" class="text-[11px] text-brand-600 font-semibold">View Suite &rarr;</a>
        </div>
        <div class="space-y-1 pl-1">
          {pdfTools.map((t) => (
            <a
              href={`/pdf/${t.slug}`}
              class="block px-2.5 py-1.5 rounded-lg text-xs font-medium text-surface-700 hover:bg-surface-100 hover:text-surface-950 transition"
            >
              {t.title}
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Drawer Footer -->
    <div class="p-4 border-t border-surface-100 bg-surface-50">
      <PrivacyBadge variant="header" class="w-full justify-center" />
      <p class="text-[11px] text-surface-400 text-center mt-3 font-mono">
        &copy; {new Date().getFullYear()} PureFile &bull; 100% On-Device
      </p>
    </div>
  </div>


<script>
  // 1. Desktop Dropdown Handlers
  const dropdownGroups = document.querySelectorAll<HTMLElement>('.dropdown-group');

  dropdownGroups.forEach((group) => {
    const trigger = group.querySelector<HTMLButtonElement>('.dropdown-trigger');
    const panel = group.querySelector<HTMLElement>('.dropdown-panel');
    const chevron = group.querySelector<HTMLElement>('.chevron');

    if (!trigger || !panel) return;

    let timeoutId: number | undefined;

    function openMenu() {
      clearTimeout(timeoutId);
      // Close other open dropdowns
      dropdownGroups.forEach((other) => {
        if (other !== group) {
          other.querySelector<HTMLElement>('.dropdown-panel')?.classList.add('hidden');
          other.querySelector<HTMLButtonElement>('.dropdown-trigger')?.setAttribute('aria-expanded', 'false');
          other.querySelector<HTMLElement>('.chevron')?.classList.remove('rotate-180');
        }
      });
      panel?.classList.remove('hidden');
      trigger?.setAttribute('aria-expanded', 'true');
      chevron?.classList.add('rotate-180');
    }

    function closeMenu() {
      timeoutId = window.setTimeout(() => {
        panel?.classList.add('hidden');
        trigger?.setAttribute('aria-expanded', 'false');
        chevron?.classList.remove('rotate-180');
      }, 150);
    }

    // Hover interactions
    group.addEventListener('mouseenter', openMenu);
    group.addEventListener('mouseleave', closeMenu);

    // Click toggle
    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = !panel.classList.contains('hidden');
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    // Keyboard Escape
    group.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        panel.classList.add('hidden');
        trigger.setAttribute('aria-expanded', 'false');
        chevron?.classList.remove('rotate-180');
        trigger.focus();
      }
    });
  });

  // Close dropdowns on outside click
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('.dropdown-group')) {
      dropdownGroups.forEach((group) => {
        group.querySelector<HTMLElement>('.dropdown-panel')?.classList.add('hidden');
        group.querySelector<HTMLButtonElement>('.dropdown-trigger')?.setAttribute('aria-expanded', 'false');
        group.querySelector<HTMLElement>('.chevron')?.classList.remove('rotate-180');
      });
    }
  });

  // 2. Mobile Drawer Handlers
  const mobileMenuBtn = document.getElementById('mobile-menu-btn') as HTMLButtonElement | null;
  const mobileDrawer = document.getElementById('mobile-drawer') as HTMLElement | null;
  const mobileBackdrop = document.getElementById('mobile-drawer-backdrop') as HTMLElement | null;
  const mobileDrawerClose = document.getElementById('mobile-drawer-close') as HTMLButtonElement | null;

  function openMobileDrawer() {
    if (!mobileDrawer || !mobileBackdrop || !mobileMenuBtn) return;
    mobileDrawer.classList.remove('hidden');
    mobileBackdrop.classList.remove('hidden');
    mobileMenuBtn.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    mobileDrawerClose?.focus();
  }

  function closeMobileDrawer() {
    if (!mobileDrawer || !mobileBackdrop || !mobileMenuBtn) return;
    mobileDrawer.classList.add('hidden');
    mobileBackdrop.classList.add('hidden');
    mobileMenuBtn.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    mobileMenuBtn.focus();
  }

  if (mobileMenuBtn) {
    mobileMenuBtn.addEventListener('click', () => {
      const isExpanded = mobileMenuBtn.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        closeMobileDrawer();
      } else {
        openMobileDrawer();
      }
    });
  }

  if (mobileDrawerClose) {
    mobileDrawerClose.addEventListener('click', closeMobileDrawer);
  }

  if (mobileBackdrop) {
    mobileBackdrop.addEventListener('click', closeMobileDrawer);
  }

  // Keyboard Escape for mobile drawer
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mobileDrawer && !mobileDrawer.classList.contains('hidden')) {
      closeMobileDrawer();
    }
  });
</script>
