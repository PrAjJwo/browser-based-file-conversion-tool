---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getActiveTools, type Tool } from '../data/tools';

const topTools: Tool[] = getActiveTools().slice(0, 6);
---

<BaseLayout
  title="404 — Page Not Found | PureFile"
  description="The requested page could not be found. Return to PureFile's client-side conversion tools."
  robots="noindex, follow"
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-brand-50 border border-brand-200/60 text-brand-600 mb-6 font-mono text-2xl font-black shadow-xs">
      404
    </div>

    <h1 class="text-3xl sm:text-4xl font-extrabold text-surface-950 tracking-tight mb-3">
      Page not found
    </h1>

    <p class="text-sm sm:text-base text-surface-600 max-w-md mx-auto mb-8 leading-relaxed">
      The link you clicked may be broken, or the page may have been moved. All file conversions are available from our homepage.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-3 mb-12">
      <a
        href="/"
        class="px-5 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-500 active:bg-brand-700 text-white font-semibold text-xs sm:text-sm shadow-xs transition-colors"
      >
        Back to Homepage
      </a>
      <a
        href="/#tools-directory"
        class="px-5 py-2.5 rounded-xl bg-white hover:bg-surface-50 border border-surface-200 text-surface-700 font-semibold text-xs sm:text-sm shadow-xs transition-colors"
      >
        Browse All Utilities
      </a>
    </div>

    <!-- Quick Tool Suggestions -->
    <div class="pt-8 border-t border-surface-200 text-left">
      <span class="text-xs font-bold text-surface-400 uppercase tracking-wider block mb-4 text-center">
        Popular Free Converters
      </span>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {topTools.map((tool: Tool) => (
          <a
            href={`/${tool.category}/${tool.slug}`}
            class="flex items-center justify-between p-3.5 rounded-xl bg-white border border-surface-200/80 hover:border-brand-300 hover:bg-brand-50/20 transition-all text-xs group"
          >
            <div>
              <span class="font-semibold text-surface-900 group-hover:text-brand-700 transition-colors">
                {tool.title}
              </span>
              <p class="text-[11px] text-surface-500 mt-0.5">
                {(tool.shortBlurb || tool.metaDescription).slice(0, 48)}...
              </p>
            </div>
            <span class="text-surface-400 group-hover:text-brand-600 transition-colors text-xs font-mono ml-2">
              &rarr;
            </span>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
