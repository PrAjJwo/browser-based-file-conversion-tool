---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCard from '../../components/ToolCard.astro';
import PrivacyBadge from '../../components/PrivacyBadge.astro';
import { getAllCategories, getToolsByCategory, getCategoryInfo, type ToolCategory } from '../../data/tools';

export function getStaticPaths() {
  const categories = getAllCategories();
  return categories.map((cat) => ({
    params: { category: cat.id },
  }));
}

const { category } = Astro.params as { category: ToolCategory };
const categoryInfo = getCategoryInfo(category);
const tools = getToolsByCategory(category);

// Grouping logic
const hasGroups = tools.some((t) => !!t.group);
const groups = hasGroups
  ? Array.from(new Set(tools.map((t) => t.group || 'General Utilities')))
  : [];

const siteOrigin = Astro.site ? Astro.site.origin : (process.env.SITE_URL || 'https://purefile.tools');
const categoryUrl = new URL(Astro.url.pathname, siteOrigin).href;
const homeUrl = new URL('/', siteOrigin).href;

const isAudio = category === 'audio';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: homeUrl,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: categoryInfo.name,
      item: categoryUrl,
    },
  ],
};
---

<BaseLayout
  title={`${categoryInfo.name} — Free Client-Side File Tools`}
  metaDescription={`${categoryInfo.description} 100% private, client-side, zero server uploads.`}
  schemaJson={breadcrumbSchema}
  robots={isAudio ? 'noindex, follow' : 'index, follow'}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- 1. Standardized Subtle Breadcrumbs -->
    <nav class="flex items-center gap-1.5 text-xs text-surface-400 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-surface-900 transition-colors">Home</a>
      <span aria-hidden="true" class="text-surface-300">/</span>
      <span class="text-surface-700 font-semibold" aria-current="page">{categoryInfo.name}</span>
    </nav>

    <!-- 2. Category Header Block -->
    <div class="mb-8 pb-6 border-b border-surface-200/80">
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-md bg-brand-50 text-brand-700 border border-brand-200/70 font-mono">
          {categoryInfo.badge}
        </span>
        {!isAudio && (
          <span class="text-[11px] font-semibold px-2.5 py-0.5 rounded-md bg-surface-100 text-surface-700 border border-surface-200">
            {tools.length} Active {tools.length === 1 ? 'Tool' : 'Tools'}
          </span>
        )}
      </div>

      <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-surface-950 tracking-tight">
        {categoryInfo.name}
      </h1>

      <p class="mt-2 text-sm sm:text-base text-surface-600 max-w-2xl leading-relaxed">
        {categoryInfo.description}
      </p>

      <!-- Compact Trust Reminder (Replaces giant green boxes) -->
      <div class="mt-4">
        <PrivacyBadge variant="tool-proof" />
      </div>
    </div>

    <!-- 3. Category Tools Presentation -->
    {isAudio ? (
      <!-- Refined Human In-Development Notice (No developer jargon) -->
      <div class="p-8 sm:p-12 text-center rounded-2xl bg-white border border-surface-200 shadow-2xs max-w-2xl mx-auto my-6">
        <div class="w-12 h-12 mx-auto rounded-xl bg-surface-100 text-surface-600 flex items-center justify-center mb-4">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.114 5.636a9 9 0 010 12.728M16.463 8.288a5.25 5.25 0 010 7.424M6.75 8.25l4.72-4.72a.75.75 0 011.28.53v15.88a.75.75 0 01-1.28.53l-4.72-4.72H4.51c-.88 0-1.704-.507-1.938-1.354A9.01 9.01 0 012.25 12c0-.83.112-1.633.322-2.396C2.806 8.757 3.63 8.25 4.51 8.25H6.75z" />
          </svg>
        </div>
        <h2 class="text-lg font-bold text-surface-950">Audio Tools Under Development</h2>
        <p class="text-xs sm:text-sm text-surface-500 mt-2 leading-relaxed max-w-md mx-auto">
          Client-side audio conversion, waveform editing, and audio track trimming are currently being engineered with the Web Audio API. Everything will execute 100% locally in your browser memory.
        </p>
        <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
          <a href="/image" class="btn-secondary btn-sm">Explore Image Tools</a>
          <a href="/video" class="btn-secondary btn-sm">Explore Video Tools</a>
          <a href="/pdf" class="btn-secondary btn-sm">Explore PDF Tools</a>
        </div>
      </div>
    ) : category === 'video' ? (
      <!-- Video Category: Intentional Featured Presentation for 1 Tool -->
      <div class="space-y-8">
        <div class="p-6 sm:p-8 rounded-2xl bg-white border border-surface-200 shadow-2xs">
          <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
            <div class="space-y-3 max-w-xl">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                <span class="text-xs font-mono uppercase text-surface-500 font-bold tracking-wider">Active In-Browser Engine</span>
              </div>
              <h2 class="text-xl sm:text-2xl font-bold text-surface-950">Video Compressor</h2>
              <p class="text-xs sm:text-sm text-surface-600 leading-relaxed">
                Compress MP4 and MOV video files directly in your browser to meet Discord (8 MB / 25 MB), WhatsApp (16 MB), and email attachment size limits without uploading gigabytes of private footage to cloud servers.
              </p>
              <div class="flex flex-wrap gap-2 pt-1 text-xs">
                <span class="px-2.5 py-1 rounded-md bg-surface-100 text-surface-700 font-mono text-[11px]">MP4 &bull; MOV</span>
                <span class="px-2.5 py-1 rounded-md bg-surface-100 text-surface-700 font-mono text-[11px]">WebAssembly FFmpeg</span>
                <span class="px-2.5 py-1 rounded-md bg-surface-100 text-surface-700 font-mono text-[11px]">Local RAM Memory</span>
              </div>
            </div>
            <div class="flex flex-col gap-2.5 flex-shrink-0">
              <a href="/video/video-compressor" class="btn-primary btn-md">
                <span>Launch Video Compressor</span>
                <span>&rarr;</span>
              </a>
              <span class="text-[11px] text-surface-400 text-center font-mono">Zero server queues</span>
            </div>
          </div>
        </div>

        <!-- Technical Capabilities Block -->
        <div class="p-5 rounded-xl bg-surface-50 border border-surface-200/80">
          <h3 class="text-xs font-bold uppercase tracking-wider text-surface-900 mb-2">
            Client-Side Video Architecture
          </h3>
          <p class="text-xs text-surface-600 leading-relaxed">
            Our video compressor compiles FFmpeg into a single-threaded WebAssembly binary that runs in an isolated browser Worker. Video streams are demuxed, re-encoded with custom bitrate allocations, and exported as in-memory MP4 Blobs.
          </p>
        </div>
      </div>
    ) : (
      <!-- Image & PDF Categories: Grouped Active Tool Grids -->
      <div class="space-y-10">
        {groups.map((groupName) => {
          const groupTools = tools.filter((t) => (t.group || 'General Utilities') === groupName);
          return (
            <div>
              <div class="flex items-center justify-between mb-4 pb-2 border-b border-surface-200/70">
                <h2 class="text-base sm:text-lg font-bold text-surface-950 flex items-center gap-2">
                  <span>{groupName}</span>
                  <span class="text-xs font-mono text-surface-400 font-normal">({groupTools.length})</span>
                </h2>
              </div>
              <div class={`grid grid-cols-1 ${groupTools.length === 2 ? 'sm:grid-cols-2' : 'md:grid-cols-2 lg:grid-cols-3'} gap-5`}>
                {groupTools.map((tool) => (
                  <ToolCard tool={tool} />
                ))}
              </div>
            </div>
          );
        })}

        <!-- Category Technical Overview -->
        <div class="mt-12 p-5 rounded-xl bg-surface-50 border border-surface-200/80">
          <h3 class="text-xs font-bold uppercase tracking-wider text-surface-900 mb-2">
            {category === 'image' ? 'Client-Side Image Processing Engine' : 'Document Compilation & Text Parsing Engine'}
          </h3>
          <p class="text-xs text-surface-600 leading-relaxed">
            {category === 'image'
              ? 'All image manipulations run directly on your GPU and CPU via HTML5 Canvas 2D contexts, WebAssembly libheif encoders, and lossless blob serialization. Original image pixel data never leaves your computer.'
              : 'PDF compilation and subtitle format serialization execute strictly in client-side JavaScript. Cue timestamps and binary documents are structured directly in memory without cloud server roundtrips.'}
          </p>
        </div>
      </div>
    )}
  </div>
</BaseLayout>
