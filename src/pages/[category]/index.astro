---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCard from '../../components/ToolCard.astro';
import PrivacyBadge from '../../components/PrivacyBadge.astro';
import { getAllCategories, getToolsByCategory, getCategoryInfo, type ToolCategory } from '../../data/tools';

export function getStaticPaths() {
  const categories = getAllCategories();
  return categories.map((cat) => ({
    params: { category: cat.id },
  }));
}

const { category } = Astro.params as { category: ToolCategory };
const categoryInfo = getCategoryInfo(category);
const tools = getToolsByCategory(category);

const hasGroups = tools.some((t) => !!t.group);
const groups = hasGroups
  ? Array.from(new Set(tools.map((t) => t.group || 'Other Tools')))
  : [];

const siteOrigin = Astro.site ? Astro.site.origin : (process.env.SITE_URL || 'https://browserfiletools.com');
const categoryUrl = new URL(Astro.url.pathname, siteOrigin).href;
const homeUrl = new URL('/', siteOrigin).href;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: homeUrl,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: categoryInfo.name,
      item: categoryUrl,
    },
  ],
};
---

<BaseLayout
  title={`${categoryInfo.name} | Browser File Tools`}
  metaDescription={`${categoryInfo.description} 100% private, client-side, zero server uploads.`}
  schemaJson={breadcrumbSchema}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-surface-500 mb-6 flex-wrap" aria-label="Breadcrumb">
      <ol class="inline-flex items-center gap-1.5 flex-wrap">
        <li class="inline-flex items-center">
          <a href="/" class="hover:text-brand-600 focus-visible:outline-brand-500 transition-colors">Home</a>
        </li>
        <li class="inline-flex items-center gap-1.5" aria-current="page">
          <span aria-hidden="true">/</span>
          <span class="text-surface-900 font-medium">{categoryInfo.name}</span>
        </li>
      </ol>
    </nav>

    <!-- Header -->
    <div class="mb-10">
      <div class="inline-flex items-center gap-2 mb-3">
        <span class="text-xs font-semibold uppercase tracking-wider px-2.5 py-1 rounded-full bg-brand-50 text-brand-700 border border-brand-200/60">
          {categoryInfo.badge}
        </span>
        <PrivacyBadge variant="compact" />
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-surface-950 tracking-tight">
        {categoryInfo.name}
      </h1>

      <p class="mt-3 text-base sm:text-lg text-surface-600 max-w-2xl leading-relaxed">
        {categoryInfo.description}
      </p>
    </div>

    <!-- Privacy Banner -->
    <div class="mb-10">
      <PrivacyBadge variant="prominent" />
    </div>

    <!-- Tools List -->
    <section aria-label={`${categoryInfo.name} list`}>
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-lg font-bold text-surface-900">Available Converters</h2>
        <span class="text-xs text-surface-500">{tools.length} tool{tools.length === 1 ? '' : 's'} registered</span>
      </div>

      {tools.length > 0 ? (
        hasGroups ? (
          <div class="space-y-10">
            {groups.map((groupName) => {
              const groupTools = tools.filter((t) => (t.group || 'Other Tools') === groupName);
              return (
                <div>
                  <div class="flex items-center gap-2 mb-4 pb-2 border-b border-surface-200/60">
                    <h3 class="text-base sm:text-lg font-bold text-surface-900">{groupName}</h3>
                    <span class="text-xs text-surface-400">({groupTools.length})</span>
                  </div>
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    {groupTools.map((tool) => (
                      <ToolCard tool={tool} />
                    ))}
                  </div>
                </div>
              );
            })}
          </div>
        ) : (
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            {tools.map((tool) => (
              <ToolCard tool={tool} />
            ))}
          </div>
        )
      ) : (
        <div class="text-center py-16 px-4 rounded-2xl bg-white border border-surface-200/80">
          <div class="w-12 h-12 mx-auto rounded-full bg-surface-100 text-surface-400 flex items-center justify-center mb-3">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-base font-semibold text-surface-900">Tools in Preparation</h3>
          <p class="text-xs sm:text-sm text-surface-500 mt-1 max-w-sm mx-auto">
            Tools for this category are queued in our architecture plan. Check back as we activate more in-browser converters!
          </p>
          <a
            href="/"
            class="mt-5 inline-flex items-center text-xs font-semibold text-brand-600 hover:text-brand-700 underline underline-offset-4"
          >
            &larr; Back to all tools
          </a>
        </div>
      )}
    </section>
  </div>
</BaseLayout>
