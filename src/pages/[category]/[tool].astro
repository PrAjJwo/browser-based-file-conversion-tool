---
import ToolLayout from '../../layouts/ToolLayout.astro';
import FileDropzone from '../../components/FileDropzone.astro';
import HeicToJpgTool from '../../components/tools/HeicToJpgTool.astro';
import VideoCompressorTool from '../../components/tools/VideoCompressorTool.astro';
import JpgToHeicTool from '../../components/tools/JpgToHeicTool.astro';
import HeicContent from '../../components/tools/HeicContent.astro';
import VideoCompressorContent from '../../components/tools/VideoCompressorContent.astro';
import JpgToHeicContent from '../../components/tools/JpgToHeicContent.astro';
import ImageToPdfTool from '../../components/tools/ImageToPdfTool.astro';
import ImageToPdfContent from '../../components/tools/ImageToPdfContent.astro';
import SubtitleConverterTool from '../../components/tools/SubtitleConverterTool.astro';
import SubtitleConverterContent from '../../components/tools/SubtitleConverterContent.astro';
import ImageResizerTool from '../../components/tools/ImageResizerTool.astro';
import ImageResizerContent from '../../components/tools/ImageResizerContent.astro';
import { getAllTools, type Tool } from '../../data/tools';

export function getStaticPaths() {
  const tools = getAllTools();
  return tools.map((tool) => ({
    params: {
      category: tool.category,
      tool: tool.slug,
    },
    props: { tool },
  }));
}

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
---

<ToolLayout
  title={tool.title}
  metaDescription={tool.metaDescription}
  tool={tool}
>
  <div slot="tool">
    {tool.slug === 'heic-to-jpg' ? (
      <HeicToJpgTool tool={tool} />
    ) : tool.slug === 'jpg-to-heic' ? (
      <JpgToHeicTool tool={tool} />
    ) : tool.slug === 'image-resizer' ? (
      <ImageResizerTool tool={tool} />
    ) : tool.slug === 'video-compressor' ? (
      <VideoCompressorTool tool={tool} />
    ) : tool.slug === 'image-to-pdf' ? (
      <ImageToPdfTool tool={tool} />
    ) : tool.slug === 'subtitle-converter' ? (
      <SubtitleConverterTool tool={tool} />
    ) : (
      <FileDropzone
        toolTitle={tool.title}
        acceptedFiles={tool.acceptedFiles}
        acceptedTypesLabel={tool.acceptedTypesLabel}
        sizeWarningMB={tool.sizeWarningMB}
        sizeCeilingNote={tool.sizeCeilingNote}
        status={tool.status}
      />
    )}
  </div>

  {tool.slug === 'heic-to-jpg' ? (
    <div slot="editorial">
      <HeicContent />
    </div>
  ) : tool.slug === 'jpg-to-heic' ? (
    <div slot="editorial">
      <JpgToHeicContent />
    </div>
  ) : tool.slug === 'image-resizer' ? (
    <div slot="editorial">
      <ImageResizerContent />
    </div>
  ) : tool.slug === 'video-compressor' ? (
    <div slot="editorial">
      <VideoCompressorContent />
    </div>
  ) : tool.slug === 'image-to-pdf' ? (
    <div slot="editorial">
      <ImageToPdfContent />
    </div>
  ) : tool.slug === 'subtitle-converter' ? (
    <div slot="editorial">
      <SubtitleConverterContent />
    </div>
  ) : null}
</ToolLayout>

