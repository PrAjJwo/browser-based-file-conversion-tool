---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getActiveTools } from '../data/tools';

const activeTools = getActiveTools();
---

<BaseLayout
  title="About PureFile — Fast, Private On-Device File Utilities"
  description="Learn about PureFile's mission to provide fast, privacy-first file conversion and processing utilities that run 100% in your local browser memory."
  canonicalUrl="https://purefile.dev/about"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-1.5 text-xs text-surface-500 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-brand-600 transition-colors">Home</a>
      <span>/</span>
      <span class="text-surface-900 font-medium" aria-current="page">About</span>
    </nav>

    <!-- Header -->
    <div class="mb-12">
      <div class="inline-flex items-center gap-2 mb-3">
        <span class="px-2.5 py-1 rounded-md text-xs font-semibold bg-brand-50 text-brand-700 border border-brand-200/60">
          Our Architecture &amp; Mission
        </span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-surface-950 tracking-tight">
        File utilities that respect your privacy.
      </h1>
      <p class="mt-3 text-base sm:text-lg text-surface-600 leading-relaxed max-w-2xl">
        PureFile was created to end the era of uploading personal documents, photos, and video recordings to anonymous remote servers just to change a file format or resize an image.
      </p>
    </div>

    <!-- Core Value Pillars -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
      <div class="p-6 rounded-2xl bg-white border border-surface-200/80 shadow-xs">
        <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center border border-emerald-200/60 mb-4">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
          </svg>
        </div>
        <h2 class="text-base font-bold text-surface-900 mb-1">Local Sandbox Execution</h2>
        <p class="text-xs text-surface-500 leading-relaxed">
          Every byte of your file is read, decoded, and transformed strictly inside your browser's sandboxed memory using your local CPU and GPU.
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-white border border-surface-200/80 shadow-xs">
        <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-700 flex items-center justify-center border border-brand-200/60 mb-4">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
          </svg>
        </div>
        <h2 class="text-base font-bold text-surface-900 mb-1">Zero Network Latency</h2>
        <p class="text-xs text-surface-500 leading-relaxed">
          No waiting for multi-gigabyte uploads over slow connections. Conversions begin the instant you drop your files.
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-white border border-surface-200/80 shadow-xs">
        <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-700 flex items-center justify-center border border-indigo-200/60 mb-4">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
          </svg>
        </div>
        <h2 class="text-base font-bold text-surface-900 mb-1">Zero Tracking &bull; Free Forever</h2>
        <p class="text-xs text-surface-500 leading-relaxed">
          No registration required, no subscription paywalls, and no hidden tracking cookies. Built as a permanent web utility.
        </p>
      </div>
    </div>

    <!-- Technical Architecture Section -->
    <div class="rounded-2xl bg-white border border-surface-200/80 p-6 sm:p-8 shadow-xs mb-12">
      <h2 class="text-xl font-bold text-surface-900 mb-3">How PureFile Works Technologically</h2>
      <p class="text-xs sm:text-sm text-surface-600 leading-relaxed mb-6">
        Modern web browsers feature high-performance runtime environments capable of running native-speed compiled code. PureFile leverages these standards:
      </p>

      <div class="space-y-4 text-xs sm:text-sm">
        <div class="flex items-start gap-3 p-3.5 rounded-xl bg-surface-50 border border-surface-200/60">
          <span class="font-mono text-xs font-bold text-brand-700 px-2 py-0.5 rounded bg-brand-100/60 flex-shrink-0">WebAssembly</span>
          <p class="text-surface-600 leading-relaxed">
            Compiled C/C++ libraries (including FFmpeg for video transcoding and libheif for Apple HEIC decoding/encoding) run directly inside browser threads with memory safety.
          </p>
        </div>

        <div class="flex items-start gap-3 p-3.5 rounded-xl bg-surface-50 border border-surface-200/60">
          <span class="font-mono text-xs font-bold text-brand-700 px-2 py-0.5 rounded bg-brand-100/60 flex-shrink-0">HTML5 Canvas</span>
          <p class="text-surface-600 leading-relaxed">
            Hardware-accelerated pixel manipulation provides fast image scaling, multi-format export (JPEG, PNG, WebP), and custom aspect ratio framing.
          </p>
        </div>

        <div class="flex items-start gap-3 p-3.5 rounded-xl bg-surface-50 border border-surface-200/60">
          <span class="font-mono text-xs font-bold text-brand-700 px-2 py-0.5 rounded bg-brand-100/60 flex-shrink-0">Client-Side Streams</span>
          <p class="text-surface-600 leading-relaxed">
            File reading via <code class="text-[11px] bg-surface-200/60 px-1 py-0.5 rounded text-surface-800">FileReader</code> and <code class="text-[11px] bg-surface-200/60 px-1 py-0.5 rounded text-surface-800">Blob</code> APIs enables immediate saving to your computer via programmatic Object URLs with zero backend communication.
          </p>
        </div>
      </div>
    </div>

    <!-- Active Tools Directory CTA -->
    <div class="rounded-2xl bg-surface-900 text-white p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div>
        <h2 class="text-lg font-bold">Ready to convert a file?</h2>
        <p class="text-xs text-surface-300 mt-1">
          Explore all {activeTools.length} client-side converters available on PureFile today.
        </p>
      </div>
      <a
        href="/#tools-directory"
        class="px-5 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-500 active:bg-brand-700 text-white font-semibold text-xs sm:text-sm shadow-xs transition-colors flex-shrink-0"
      >
        Browse All Utilities &rarr;
      </a>
    </div>
  </div>
</BaseLayout>
