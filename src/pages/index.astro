<!-- Client-side Search & Category Filtering Script -->
<script>
  function setupToolFinder() {
    const searchInput = document.getElementById('tool-search-input') as HTMLInputElement | null;
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.tool-grid-card'));
    const filterTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-tab-btn'));
    const countIndicator = document.getElementById('tool-count-indicator');
    const noResultsState = document.getElementById('no-results-state');
    const noResultsQueryText = document.getElementById('no-results-query-text');
    const clearSearchBtn = document.getElementById('clear-search-btn');

    let currentCategory = 'all';
    let searchQuery = '';

    function filterTools() {
      const q = searchQuery.trim().toLowerCase();
      let visibleCount = 0;

      cards.forEach((card) => {
        const cat = card.getAttribute('data-category') || '';
        const keywords = card.getAttribute('data-keywords') || '';
        const title = card.getAttribute('data-title') || '';

        const matchesCat = currentCategory === 'all' || cat === currentCategory;
        const matchesQuery = !q || keywords.includes(q) || title.includes(q);

        if (matchesCat && matchesQuery) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      // Update indicator text
      if (countIndicator) {
        if (q || currentCategory !== 'all') {
          countIndicator.textContent = `Showing ${visibleCount} of ${cards.length} tools`;
        } else {
          countIndicator.textContent = `Showing all ${cards.length} utilities ready for on-device processing`;
        }
      }

      // Update empty state
      if (noResultsState) {
        if (visibleCount === 0) {
          noResultsState.classList.remove('hidden');
          if (noResultsQueryText) {
            noResultsQueryText.textContent = q
              ? `No active converters match "${q}" in the selected filter.`
              : `No active converters found in this category.`;
          }
        } else {
          noResultsState.classList.add('hidden');
        }
      }
    }

    // Handle Search Input
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = (e.target as HTMLInputElement).value;
        filterTools();
      });

      // Keyboard shortcut '/' to focus search
      document.addEventListener('keydown', (e) => {
        if (e.key === '/' && document.activeElement !== searchInput && !['INPUT', 'TEXTAREA'].includes((document.activeElement as HTMLElement)?.tagName)) {
          e.preventDefault();
          searchInput.focus();
          searchInput.select();
        } else if (e.key === 'Escape' && document.activeElement === searchInput) {
          searchInput.value = '';
          searchQuery = '';
          searchInput.blur();
          filterTools();
        }
      });
    }

    // Handle Category Filter Tabs
    filterTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const filter = tab.getAttribute('data-filter') || 'all';
        currentCategory = filter;

        // Update tab styles
        filterTabs.forEach((t) => {
          if (t === tab) {
            t.classList.add('bg-white', 'text-surface-900', 'shadow-2xs');
            t.classList.remove('text-surface-600');
          } else {
            t.classList.remove('bg-white', 'text-surface-900', 'shadow-2xs');
            t.classList.add('text-surface-600');
          }
        });

        filterTools();
      });
    });

    // Handle Clear Search button in empty state
    if (clearSearchBtn) {
      clearSearchBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        searchQuery = '';
        currentCategory = 'all';

        filterTabs.forEach((t, i) => {
          if (i === 0) {
            t.classList.add('bg-white', 'text-surface-900', 'shadow-2xs');
            t.classList.remove('text-surface-600');
          } else {
            t.classList.remove('bg-white', 'text-surface-900', 'shadow-2xs');
            t.classList.add('text-surface-600');
          }
        });

        filterTools();
        if (searchInput) searchInput.focus();
      });
    }
  }

  // Initialize on load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupToolFinder);
  } else {
    setupToolFinder();
  }
</script>
