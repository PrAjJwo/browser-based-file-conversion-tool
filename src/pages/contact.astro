---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact & Feedback — PureFile"
  description="Get in touch with the PureFile maintainers for bug reports, tool feedback, or questions about our client-side file conversion tools."
  canonicalUrl="https://purefile.dev/contact"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-1.5 text-xs text-surface-500 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-brand-600 transition-colors">Home</a>
      <span>/</span>
      <span class="text-surface-900 font-medium" aria-current="page">Contact</span>
    </nav>

    <!-- Header -->
    <div class="mb-10 pb-6 border-b border-surface-200">
      <div class="inline-flex items-center gap-2 mb-3">
        <span class="px-2.5 py-1 rounded-md text-xs font-semibold bg-brand-50 text-brand-700 border border-brand-200/60">
          Support &amp; Community
        </span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-surface-950 tracking-tight">
        Contact &amp; Feedback
      </h1>
      <p class="mt-2 text-xs sm:text-sm text-surface-600">
        Have feedback, encountered an issue with a conversion, or want to suggest a feature? Here is how to reach us.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
      <!-- Card 1: Bug Reports -->
      <div class="p-6 rounded-2xl bg-white border border-surface-200/80 shadow-xs flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-xl bg-rose-50 text-rose-700 flex items-center justify-center border border-rose-200/60 mb-4">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
            </svg>
          </div>
          <h2 class="text-base font-bold text-surface-900 mb-1">Report a Conversion Bug</h2>
          <p class="text-xs text-surface-500 leading-relaxed mb-4">
            If a specific file format failed to parse or produced unexpected results in your browser, please submit an issue on our GitHub repository with the file type and your browser version.
          </p>
        </div>
        <a
          href="https://github.com/PrAjJwo/browser-based-file-conversion-tool/issues"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-xs font-semibold text-brand-600 hover:text-brand-700 transition-colors"
        >
          <span>Open an issue on GitHub</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
          </svg>
        </a>
      </div>

      <!-- Card 2: General Feedback -->
      <div class="p-6 rounded-2xl bg-white border border-surface-200/80 shadow-xs flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-700 flex items-center justify-center border border-brand-200/60 mb-4">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 01.865-.502 49.188 49.188 0 003.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z" />
            </svg>
          </div>
          <h2 class="text-base font-bold text-surface-900 mb-1">General Feedback &amp; Suggestions</h2>
          <p class="text-xs text-surface-500 leading-relaxed mb-4">
            We are constantly refining PureFile. Tell us which file formats or workflows you would like to see supported natively in your browser.
          </p>
        </div>
        <a
          href="https://github.com/PrAjJwo/browser-based-file-conversion-tool/discussions"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-xs font-semibold text-brand-600 hover:text-brand-700 transition-colors"
        >
          <span>Join GitHub Discussions</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Privacy Note -->
    <div class="p-4 rounded-xl bg-surface-50 border border-surface-200/70 text-xs text-surface-600 leading-relaxed">
      <strong>Privacy reminder:</strong> When submitting bug reports or example files, ensure you do not share private or sensitive personal documents on public issue trackers.
    </div>
  </div>
</BaseLayout>
