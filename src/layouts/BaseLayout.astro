---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  metaDescription?: string;
  description?: string;
  canonicalUrl?: string;
  ogType?: string;
  schemaJson?: object | object[];
  robots?: string;
}

const {
  title,
  metaDescription,
  description: propDescription,
  canonicalUrl: customCanonical,
  ogType = 'website',
  schemaJson,
  robots = 'index, follow',
} = Astro.props;

const finalDescription = metaDescription || propDescription || 'Fast, private file conversion utilities running 100% locally in your browser memory.';

const siteName = 'PureFile';
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;

// Always resolve canonical URL to production domain
const siteOrigin = Astro.site ? Astro.site.origin : (process.env.SITE_URL || 'https://purefile.tools');
const canonicalUrl = customCanonical || new URL(Astro.url.pathname, siteOrigin).href;
const schemas = schemaJson ? (Array.isArray(schemaJson) ? schemaJson : [schemaJson]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={finalDescription} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={finalDescription} />
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={fullTitle} />
    <meta property="twitter:description" content={finalDescription} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- JSON-LD Structured Data Schema -->
    {schemas.map((s) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(s)} />
    ))}
  </head>
  <body class="min-h-screen flex flex-col bg-surface-50 text-surface-900 selection:bg-brand-100 selection:text-brand-900">
    <!-- Skip to main content for keyboard accessibility -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:px-4 focus:py-2 focus:bg-brand-600 focus:text-white focus:rounded-lg focus:shadow-md focus:outline-none"
    >
      Skip to content
    </a>
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
